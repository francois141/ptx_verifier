# Build artifacts
/target
/dist
**/__pycache__/

# Volta output
/volta-logs
/bench-out

# Configuration files
.venv
/.env

# External kernels: PTX and metadata from `just setup`, CSVs from `just external`; only launch files are tracked
/external/**/*.ptx
# PyTorch's activations are compiled by hand, so their PTX is tracked like their AMD assembly
!/external/activation/*.ptx
# The fused GEMM + activation kernels are compiled by their extract.py scripts; their PTX is tracked too
!/external/approximations/**/*.ptx
/external/**/*.json
!/external/**/*.launch.json
/external/ptx/output/
# `just benchmark`'s report and figure
/external/benchmark/report.md
/external/benchmark/solving-speed.pdf
/external/benchmark/solving-speed.png
# `just approximations`'s report
/external/approximations/REPORT.md
# The Gluon tutorials, downloaded by `external/ptx/extraction/gluon.py`
/external/ptx/sources/gluon/
