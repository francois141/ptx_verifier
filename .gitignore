# Build artifacts
/target
/dist
**/__pycache__/

# Volta output
/volta-logs
/bench-out

# Configuration files
.venv
/.env

# External kernels: PTX and metadata from `just setup`, CSVs from `just external`; only launch files are tracked
/external/**/*.ptx
# PyTorch's activations are compiled by hand, so their PTX is tracked like their AMD assembly
!/external/activation/*.ptx
/external/**/*.json
!/external/**/*.launch.json
/external/ptx/output/
# `just benchmark`'s report
/external/benchmark/report.md
# The Gluon tutorials, downloaded by `external/ptx/extraction/gluon.py`
/external/ptx/sources/gluon/
