    shl.b32 %r6, %r0, 4;
    cvt.u64.u32 %g4, %r6;
    add.u64 %g4, %g1, %g4;
    add.u32 %r6, %r6, %r2;
    shl.b32 %r7, %r4, 4;
    add.u32 %r7, %r7, %r2;
    shl.b32 %r8, %r3, 1;
    mad.lo.u32 %r8, %r1, 32, %r8;
    mad.wide.u32 %g5, %r8, 2, %g2;
    setp.eq.u32 %p0, %r0, 0;
    setp.eq.u32 %p1, %r4, 0;

    // Stage the vector once in temporary shared memory while the first matrix tile arrives.
    cp.async.cg.shared.global [%r6], [%g4], 16;
    cp.async.cg.shared.global [%r6+2048], [%g4+2048], 16;
    cp.async.cg.shared.global [%r6+4096], [%g4+4096], 16;
