    // Each warp computes two real rows using eight independent K slices per MMA.
    ld.param.u64 %g0, [a_ptr];
    ld.param.u64 %g1, [x_ptr];
    ld.param.u64 %g2, [y_ptr];
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %ctaid.x;
