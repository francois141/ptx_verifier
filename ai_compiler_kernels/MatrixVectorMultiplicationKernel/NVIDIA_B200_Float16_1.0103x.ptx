    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%x0,%x1,%x2,%x3}, [%r7+0];
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%x4,%x5,%x6,%x7}, [%r7+512];
