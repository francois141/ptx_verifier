    cvt.rn.f16x2.f32 %out, %sum1, %sum0;
    @%p1 st.global.b32 [%g5], %out;

    // Readers finish before either 64-KiB matrix buffer is reused.
    bar.sync 0;
    mov.u32 %r21, %r16;
    mov.u32 %r16, %r17;
    mov.u32 %r17, %r21;
    mov.u32 %r21, %r9;
    mov.u32 %r9, %r10;
    mov.u32 %r10, %r21;
    add.u64 %g3, %g3, 65536;
    add.u64 %g5, %g5, 16;
    add.u32 %r15, %r15, 1;
    shr.u32 %r18, %r15, 1;
    and.b32 %r18, %r18, 1;
    setp.lt.u32 %p5, %r15, 4;
    @%p5 bra ROWS;
    ret;
}
