.version 8.7
.target sm_100a
.address_size 64
.extern .shared .align 16 .b8 global_smem[];
.visible .entry kernel(
.param .u64 x_ptr,
.param .u64 weight_ptr,
.param .u64 output_ptr,
.param .u64 dummy_ptr1,
.param .u64 dummy_ptr2
){
.reg .b32 %r<24>;
.reg .b64 %a<12>;
.reg .b16 %h<12>;
.reg .f32 %x<8>, %w<8>, %s, %t, %v, %q<4>;
.reg .pred %p;
// Each thread owns eight adjacent elements of one complete row.
ld.param.u64 %a0,[x_ptr];
ld.param.u64 %a1,[weight_ptr];
ld.param.u64 %a2,[output_ptr];
mov.u32 %r0,%tid.x;
mov.u32 %r1,%ctaid.x;
shl.b32 %r2,%r0,3;
mad.lo.u32 %r3,%r1,4096,%r2;
cvt.u64.u32 %a3,%r3;
add.u64 %a4,%a0,%a3;
add.u64 %a5,%a1,%a3;
shl.b64 %a3,%a3,1;
add.u64 %a6,%a2,%a3;
// Fetch both inputs early and decode eight FP8 activations.
ld.global.v2.u32 {%r4,%r5},[%a4];
ld.global.v2.u32 {%r12,%r13},[%a5];
mov.b32 {%h0,%h1},%r4;
mov.b32 {%h2,%h3},%r5;
cvt.rn.f16x2.e4m3x2 %r6,%h0;
mov.b32 {%h4,%h5},%r6;
cvt.f32.f16 %x0,%h4;
cvt.f32.f16 %x1,%h5;
cvt.rn.f16x2.e4m3x2 %r6,%h1;
mov.b32 {%h4,%h5},%r6;
cvt.f32.f16 %x2,%h4;
cvt.f32.f16 %x3,%h5;
cvt.rn.f16x2.e4m3x2 %r6,%h2;
mov.b32 {%h4,%h5},%r6;
cvt.f32.f16 %x4,%h4;
cvt.f32.f16 %x5,%h5;
cvt.rn.f16x2.e4m3x2 %r6,%h3;
mov.b32 {%h4,%h5},%r6;
cvt.f32.f16 %x6,%h4;
cvt.f32.f16 %x7,%h5;
// Independent partial sums shorten the local reduction dependency chain.
mul.f32 %q0,%x0,%x0;
mul.f32 %q1,%x2,%x2;
mul.f32 %q2,%x4,%x4;
mul.f32 %q3,%x6,%x6;
fma.rn.f32 %q0,%x1,%x1,%q0;
fma.rn.f32 %q1,%x3,%x3,%q1;
fma.rn.f32 %q2,%x5,%x5,%q2;
fma.rn.f32 %q3,%x7,%x7,%q3;
add.f32 %q0,%q0,%q1;
add.f32 %q2,%q2,%q3;
add.f32 %s,%q0,%q2;
// Reduce all thirty-two lanes in each warp.
shfl.sync.bfly.b32 %t,%s,16,31,-1;
add.f32 %s,%s,%t;
shfl.sync.bfly.b32 %t,%s,8,31,-1;
add.f32 %s,%s,%t;
shfl.sync.bfly.b32 %t,%s,4,31,-1;
add.f32 %s,%s,%t;
shfl.sync.bfly.b32 %t,%s,2,31,-1;
add.f32 %s,%s,%t;
shfl.sync.bfly.b32 %t,%s,1,31,-1;
add.f32 %s,%s,%t;
// Publish sixteen warp sums using exactly 64 dynamic shared bytes.
and.b32 %r7,%r0,31;
shr.u32 %r8,%r0,5;
mov.u32 %r9,global_smem;
mad.lo.u32 %r10,%r8,4,%r9;
setp.eq.u32 %p,%r7,0;
@%p st.shared.f32 [%r10],%s;
bar.sync 0;
// Every warp independently reduces the same sixteen partial sums.
and.b32 %r11,%r7,15;
mad.lo.u32 %r10,%r11,4,%r9;
ld.shared.f32 %s,[%r10];
shfl.sync.bfly.b32 %t,%s,8,31,-1;
add.f32 %s,%s,%t;
shfl.sync.bfly.b32 %t,%s,4,31,-1;
add.f32 %s,%s,%t;
shfl.sync.bfly.b32 %t,%s,2,31,-1;
add.f32 %s,%s,%t;
shfl.sync.bfly.b32 %t,%s,1,31,-1;
add.f32 %s,%s,%t;
mul.f32 %s,%s,0f39800000;
add.f32 %s,%s,0f358637bd;
rsqrt.approx.f32 %v,%s;
// Decode the prefetched weights without further global loads.
mov.b32 {%h0,%h1},%r12;
mov.b32 {%h2,%h3},%r13;
cvt.rn.f16x2.e4m3x2 %r6,%h0;
mov.b32 {%h4,%h5},%r6;
cvt.f32.f16 %w0,%h4;
cvt.f32.f16 %w1,%h5;
cvt.rn.f16x2.e4m3x2 %r6,%h1;
mov.b32 {%h4,%h5},%r6;
cvt.f32.f16 %w2,%h4;
cvt.f32.f16 %w3,%h5;
cvt.rn.f16x2.e4m3x2 %r6,%h2;
mov.b32 {%h4,%h5},%r6;
cvt.f32.f16 %w4,%h4;
cvt.f32.f16 %w5,%h5;
cvt.rn.f16x2.e4m3x2 %r6,%h3;
mov.b32 {%h4,%h5},%r6;
cvt.f32.f16 %w6,%h4;
cvt.f32.f16 %w7,%h5;
// Preserve the FP32 order: normalize first, then multiply by weight.
mul.f32 %x0,%x0,%v;
mul.f32 %x1,%x1,%v;
mul.f32 %x2,%x2,%v;
mul.f32 %x3,%x3,%v;
mul.f32 %x4,%x4,%v;
mul.f32 %x5,%x5,%v;
mul.f32 %x6,%x6,%v;
mul.f32 %x7,%x7,%v;
mul.f32 %x0,%x0,%w0;
mul.f32 %x1,%x1,%w1;
mul.f32 %x2,%x2,%w2;
mul.f32 %x3,%x3,%w3;
mul.f32 %x4,%x4,%w4;
mul.f32 %x5,%x5,%w5;
mul.f32 %x6,%x6,%w6;
mul.f32 %x7,%x7,%w7;
// Round to FP16 and store the contiguous sixteen-byte output segment.
cvt.rn.f16x2.f32 %r16,%x1,%x0;
cvt.rn.f16x2.f32 %r17,%x3,%x2;
cvt.rn.f16x2.f32 %r18,%x5,%x4;
cvt.rn.f16x2.f32 %r19,%x7,%x6;
st.global.v4.u32 [%a6],{%r16,%r17,%r18,%r19};
ret;
}