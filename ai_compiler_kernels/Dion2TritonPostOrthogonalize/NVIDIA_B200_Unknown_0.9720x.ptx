.version 8.7
.target sm_100a
.address_size 64
.extern .shared .align 16 .b8 global_smem[];
.visible .entry kernel(
 .param .u64 X_ptr, .param .u64 U_ptr, .param .u64 map_ptr,
 .param .u64 a_ptr, .param .u64 b_ptr,
 .param .u64 dummy_ptr1, .param .u64 dummy_ptr2
)
{
 .reg .b32 %r<40>;
 .reg .b64 %rd<20>, %xx<16>, %aa, %bb, %uu0, %uu1;
 .reg .f32 %a, %b, %u<4>;
 // Load tensor bases and decode the batch and 64 by 64 tile.
 ld.param.u64 %rd0, [X_ptr];
 ld.param.u64 %rd1, [U_ptr];
 ld.param.u64 %rd2, [map_ptr];
 mov.u32 %r0, %tid.x;
 mov.u32 %r1, %ctaid.x;
 shr.u32 %r2, %r1, 6;
 shr.u32 %r3, %r1, 3;
 and.b32 %r3, %r3, 7;
 shl.b32 %r3, %r3, 6;
 and.b32 %r4, %r1, 7;
 shl.b32 %r4, %r4, 6;
 // Stage all 64 by 32 U values into exactly 8192 dynamic shared bytes.
 mad.lo.u32 %r7, %r2, 512, %r3;
 shl.b32 %r7, %r7, 7;
 shl.b32 %r8, %r0, 4;
 add.u32 %r7, %r7, %r8;
 cvt.u64.u32 %rd5, %r7;
 add.u64 %rd5, %rd1, %rd5;
 mov.u32 %r9, global_smem;
 shr.u32 %r10, %r0, 3;
 and.b32 %r10, %r10, 7;
 shl.b32 %r10, %r10, 4;
 xor.b32 %r8, %r8, %r10;
 add.u32 %r8, %r8, %r9;
 cp.async.cg.shared.global [%r8], [%rd5], 16;
 add.u32 %r8, %r8, 2048;
 add.u64 %rd5, %rd5, 2048;
 cp.async.cg.shared.global [%r8], [%rd5], 16;
 add.u32 %r8, %r8, 2048;
 add.u64 %rd5, %rd5, 2048;
 cp.async.cg.shared.global [%r8], [%rd5], 16;
 add.u32 %r8, %r8, 2048;
 add.u64 %rd5, %rd5, 2048;
 cp.async.cg.shared.global [%r8], [%rd5], 16;
 cp.async.commit_group;
 // Fetch the live scales and four map entries while U is in flight.
 ld.param.u64 %rd3, [a_ptr];
 ld.param.u64 %rd4, [b_ptr];
 ld.global.f32 %a, [%rd3];
 ld.global.f32 %b, [%rd4];
 neg.f32 %b, %b;
 mov.b64 %aa, {%a, %a};
 mov.b64 %bb, {%b, %b};
 shr.u32 %r5, %r0, 4;
 and.b32 %r6, %r0, 15;
 shl.b32 %r6, %r6, 2;
 add.u32 %r6, %r6, %r4;
 mad.lo.u32 %r7, %r2, 512, %r6;
 mul.wide.u32 %rd6, %r7, 4;
 add.u64 %rd6, %rd2, %rd6;
 ld.global.v4.s32 {%r12, %r13, %r14, %r15}, [%rd6];
 // The source loads U column zero for every negative map value.
 max.s32 %r12, %r12, 0;
 max.s32 %r13, %r13, 0;
 max.s32 %r14, %r14, 0;
 max.s32 %r15, %r15, 0;
 // Swizzle U columns by row to avoid duplicate bank conflicts across rows.
 shl.b32 %r16, %r5, 2;
 xor.b32 %r12, %r12, %r16;
 xor.b32 %r13, %r13, %r16;
 xor.b32 %r14, %r14, %r16;
 xor.b32 %r15, %r15, %r16;
 shl.b32 %r17, %r5, 7;
 add.u32 %r17, %r17, %r9;
 mad.lo.u32 %r12, %r12, 4, %r17;
 mad.lo.u32 %r13, %r13, 4, %r17;
 mad.lo.u32 %r14, %r14, 4, %r17;
 mad.lo.u32 %r15, %r15, 4, %r17;
 // Eight row groups give each thread 32 contiguous-within-row X elements.
 add.u32 %r5, %r5, %r3;
 mad.lo.u32 %r18, %r2, 512, %r5;
 mad.lo.u32 %r18, %r18, 512, %r6;
 mul.wide.u32 %rd7, %r18, 4;
 add.u64 %rd7, %rd0, %rd7;
 ld.global.v2.b64 {%xx0, %xx1}, [%rd7+0];
 ld.global.v2.b64 {%xx2, %xx3}, [%rd7+16384];
 ld.global.v2.b64 {%xx4, %xx5}, [%rd7+32768];
 ld.global.v2.b64 {%xx6, %xx7}, [%rd7+49152];
 ld.global.v2.b64 {%xx8, %xx9}, [%rd7+65536];
 ld.global.v2.b64 {%xx10, %xx11}, [%rd7+81920];
 ld.global.v2.b64 {%xx12, %xx13}, [%rd7+98304];
 ld.global.v2.b64 {%xx14, %xx15}, [%rd7+114688];
 // Complete asynchronous staging and publish it to all four warps.
 cp.async.wait_group 0;
 bar.sync 0;
 // Gather row group 0 and update four elements using paired float32 arithmetic.
 ld.shared.f32 %u0, [%r12+0];
 ld.shared.f32 %u1, [%r13+0];
 ld.shared.f32 %u2, [%r14+0];
 ld.shared.f32 %u3, [%r15+0];
 mov.b64 %uu0, {%u0, %u1};
 mov.b64 %uu1, {%u2, %u3};
 mul.rn.f32x2 %uu0, %bb, %uu0;
 mul.rn.f32x2 %uu1, %bb, %uu1;
 fma.rn.f32x2 %xx0, %aa, %xx0, %uu0;
 fma.rn.f32x2 %xx1, %aa, %xx1, %uu1;
 st.global.v2.b64 [%rd7+0], {%xx0, %xx1};
 // Gather row group 1 and update four elements using paired float32 arithmetic.
 ld.shared.f32 %u0, [%r12+1024];
 ld.shared.f32 %u1, [%r13+1024];
 ld.shared.f32 %u2, [%r14+1024];
 ld.shared.f32 %u3, [%r15+1024];
 mov.b64 %uu0, {%u0, %u1};
 mov.b64 %uu1, {%u2, %u3};
 mul.rn.f32x2 %uu0, %bb, %uu0;
 mul.rn.f32x2 %uu1, %bb, %uu1;
 fma.rn.f32x2 %xx2, %aa, %xx2, %uu0;
 fma.rn.f32x2 %xx3, %aa, %xx3, %uu1;
 st.global.v2.b64 [%rd7+16384], {%xx2, %xx3};
 // Gather row group 2 and update four elements using paired float32 arithmetic.
 ld.shared.f32 %u0, [%r12+2048];
 ld.shared.f32 %u1, [%r13+2048];
 ld.shared.f32 %u2, [%r14+2048];
 ld.shared.f32 %u3, [%r15+2048];
 mov.b64 %uu0, {%u0, %u1};
 mov.b64 %uu1, {%u2, %u3};
 mul.rn.f32x2 %uu0, %bb, %uu0;
 mul.rn.f32x2 %uu1, %bb, %uu1;
 fma.rn.f32x2 %xx4, %aa, %xx4, %uu0;
 fma.rn.f32x2 %xx5, %aa, %xx5, %uu1;
 st.global.v2.b64 [%rd7+32768], {%xx4, %xx5};
 // Gather row group 3 and update four elements using paired float32 arithmetic.
 ld.shared.f32 %u0, [%r12+3072];
 ld.shared.f32 %u1, [%r13+3072];
 ld.shared.f32 %u2, [%r14+3072];
 ld.shared.f32 %u3, [%r15+3072];
 mov.b64 %uu0, {%u0, %u1};
 mov.b64 %uu1, {%u2, %u3};
 mul.rn.f32x2 %uu0, %bb, %uu0;
 mul.rn.f32x2 %uu1, %bb, %uu1;
 fma.rn.f32x2 %xx6, %aa, %xx6, %uu0;
 fma.rn.f32x2 %xx7, %aa, %xx7, %uu1;
 st.global.v2.b64 [%rd7+49152], {%xx6, %xx7};
 // Gather row group 4 and update four elements using paired float32 arithmetic.
 ld.shared.f32 %u0, [%r12+4096];
 ld.shared.f32 %u1, [%r13+4096];
 ld.shared.f32 %u2, [%r14+4096];
 ld.shared.f32 %u3, [%r15+4096];
 mov.b64 %uu0, {%u0, %u1};
 mov.b64 %uu1, {%u2, %u3};
 mul.rn.f32x2 %uu0, %bb, %uu0;
 mul.rn.f32x2 %uu1, %bb, %uu1;
 fma.rn.f32x2 %xx8, %aa, %xx8, %uu0;
 fma.rn.f32x2 %xx9, %aa, %xx9, %uu1;
 st.global.v2.b64 [%rd7+65536], {%xx8, %xx9};
 // Gather row group 5 and update four elements using paired float32 arithmetic.
 ld.shared.f32 %u0, [%r12+5120];
 ld.shared.f32 %u1, [%r13+5120];
 ld.shared.f32 %u2, [%r14+5120];
 ld.shared.f32 %u3, [%r15+5120];
 mov.b64 %uu0, {%u0, %u1};
 mov.b64 %uu1, {%u2, %u3};
 mul.rn.f32x2 %uu0, %bb, %uu0;
 mul.rn.f32x2 %uu1, %bb, %uu1;
 fma.rn.f32x2 %xx10, %aa, %xx10, %uu0;
 fma.rn.f32x2 %xx11, %aa, %xx11, %uu1;
 st.global.v2.b64 [%rd7+81920], {%xx10, %xx11};
 // Gather row group 6 and update four elements using paired float32 arithmetic.
 ld.shared.f32 %u0, [%r12+6144];
 ld.shared.f32 %u1, [%r13+6144];
 ld.shared.f32 %u2, [%r14+6144];
 ld.shared.f32 %u3, [%r15+6144];
 mov.b64 %uu0, {%u0, %u1};
 mov.b64 %uu1, {%u2, %u3};
 mul.rn.f32x2 %uu0, %bb, %uu0;
 mul.rn.f32x2 %uu1, %bb, %uu1;
 fma.rn.f32x2 %xx12, %aa, %xx12, %uu0;
 fma.rn.f32x2 %xx13, %aa, %xx13, %uu1;
 st.global.v2.b64 [%rd7+98304], {%xx12, %xx13};
 // Gather row group 7 and update four elements using paired float32 arithmetic.
 ld.shared.f32 %u0, [%r12+7168];
 ld.shared.f32 %u1, [%r13+7168];
 ld.shared.f32 %u2, [%r14+7168];
 ld.shared.f32 %u3, [%r15+7168];
 mov.b64 %uu0, {%u0, %u1};
 mov.b64 %uu1, {%u2, %u3};
 mul.rn.f32x2 %uu0, %bb, %uu0;
 mul.rn.f32x2 %uu1, %bb, %uu1;
 fma.rn.f32x2 %xx14, %aa, %xx14, %uu0;
 fma.rn.f32x2 %xx15, %aa, %xx15, %uu1;
 st.global.v2.b64 [%rd7+114688], {%xx14, %xx15};
 ret;
}
