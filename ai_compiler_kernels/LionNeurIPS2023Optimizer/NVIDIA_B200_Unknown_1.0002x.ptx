.version 8.7
.target sm_100a
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 p_ptr,
    .param .u64 grad_ptr,
    .param .u64 exp_avg_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
{
    .reg .b32 %t, %bid, %idx;
    .reg .b64 %pp, %gp, %mp;
    .reg .b64 %p<2>, %g<2>, %m<2>, %d<2>, %u<2>, %s<2>;
    .reg .b64 %b1, %b2, %decay;
    .reg .f32 %v<4>, %step<4>;
    .reg .pred %pos<4>, %nz<4>;

    // Each of 256 threads covers four elements of the unmasked 1024-element tile.
    ld.param.u64 %pp, [p_ptr];
    ld.param.u64 %gp, [grad_ptr];
    ld.param.u64 %mp, [exp_avg_ptr];
    mov.u32 %t, %tid.x;
    mov.u32 %bid, %ctaid.x;
    mad.lo.u32 %idx, %bid, 256, %t;
    mad.wide.u32 %pp, %idx, 16, %pp;
    mad.wide.u32 %gp, %idx, 16, %gp;
    mad.wide.u32 %mp, %idx, 16, %mp;

    // Load aligned float4 vectors, prefetching neighboring L2 sectors.
    ld.global.L2::256B.v2.b64 {%p0, %p1}, [%pp];
    ld.global.L2::256B.v2.b64 {%g0, %g1}, [%gp];
    ld.global.L2::256B.v2.b64 {%m0, %m1}, [%mp];
    mov.b64 %b1, 0x3f6666663f666666;
    mov.b64 %b2, 0x3f7d70a43f7d70a4;
    mov.b64 %decay, 0x3f7fffef3f7fffef;

    // Reuse the momentum-gradient difference in two packed FP32 interpolations.
    sub.rn.f32x2 %d0, %m0, %g0;
    sub.rn.f32x2 %d1, %m1, %g1;
    fma.rn.f32x2 %u0, %d0, %b1, %g0;
    fma.rn.f32x2 %u1, %d1, %b1, %g1;
    fma.rn.f32x2 %m0, %d0, %b2, %g0;
    fma.rn.f32x2 %m1, %d1, %b2, %g1;

    // Match the positive, nonzero, and NaN cases of the Triton sign update.
    mov.b64 {%v0, %v1}, %u0;
    mov.b64 {%v2, %v3}, %u1;
    setp.gt.f32 %pos0, %v0, 0f00000000;
    setp.gt.f32 %pos1, %v1, 0f00000000;
    setp.gt.f32 %pos2, %v2, 0f00000000;
    setp.gt.f32 %pos3, %v3, 0f00000000;
    setp.neu.f32 %nz0, %v0, 0f00000000;
    setp.neu.f32 %nz1, %v1, 0f00000000;
    setp.neu.f32 %nz2, %v2, 0f00000000;
    setp.neu.f32 %nz3, %v3, 0f00000000;
    selp.f32 %step0, 0fb8d1b717, 0f38d1b717, %pos0;
    selp.f32 %step1, 0fb8d1b717, 0f38d1b717, %pos1;
    selp.f32 %step2, 0fb8d1b717, 0f38d1b717, %pos2;
    selp.f32 %step3, 0fb8d1b717, 0f38d1b717, %pos3;
    selp.f32 %step0, %step0, 0f00000000, %nz0;
    selp.f32 %step1, %step1, 0f00000000, %nz1;
    selp.f32 %step2, %step2, 0f00000000, %nz2;
    selp.f32 %step3, %step3, 0f00000000, %nz3;

    // Fuse the parameter decay and signed step in packed FP32 arithmetic.
    mov.b64 %s0, {%step0, %step1};
    mov.b64 %s1, {%step2, %step3};
    fma.rn.f32x2 %p0, %p0, %decay, %s0;
    fma.rn.f32x2 %p1, %p1, %decay, %s1;

    // Store parameters and momentum using coalesced 16-byte writes.
    st.global.v2.b64 [%pp], {%p0, %p1};
    st.global.v2.b64 [%mp], {%m0, %m1};
    ret;
}
