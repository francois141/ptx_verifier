    cvt.rn.f16x2.f32 %v11, %f7, %f6;
    st.shared.v4.b32 [%bp2], {%v8,%v9,%v10,%v11};

    // Scale and round the fourth vector.
    mov.b32 {%h0,%h1}, %v12;
    mov.b32 {%h2,%h3}, %v13;
    mov.b32 {%h4,%h5}, %v14;
    mov.b32 {%h6,%h7}, %v15;
    cvt.f32.f16 %f0, %h0;
    cvt.f32.f16 %f1, %h1;
    cvt.f32.f16 %f2, %h2;
    cvt.f32.f16 %f3, %h3;
    cvt.f32.f16 %f4, %h4;
    cvt.f32.f16 %f5, %h5;
    cvt.f32.f16 %f6, %h6;
    cvt.f32.f16 %f7, %h7;
    mov.b64 %zs, {%bs3,%bs3};
    mov.b64 %z0, {%f0,%f1};
    mul.rn.f32x2 %z0, %z0, %zs;
    mov.b64 {%f0,%f1}, %z0;
    cvt.rn.f16x2.f32 %v12, %f1, %f0;
    mov.b64 %z1, {%f2,%f3};
    mul.rn.f32x2 %z1, %z1, %zs;
    mov.b64 {%f2,%f3}, %z1;
    cvt.rn.f16x2.f32 %v13, %f3, %f2;
    mov.b64 %z2, {%f4,%f5};
    mul.rn.f32x2 %z2, %z2, %zs;
    mov.b64 {%f4,%f5}, %z2;
    cvt.rn.f16x2.f32 %v14, %f5, %f4;
    mov.b64 %z3, {%f6,%f7};
    mul.rn.f32x2 %z3, %z3, %zs;
    mov.b64 {%f6,%f7}, %z3;
    cvt.rn.f16x2.f32 %v15, %f7, %f6;
