.version 8.7
.target sm_100a
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 x_ptr,
    .param .u64 b_ptr,
    .param .u64 states_ptr,
    .param .u64 dt_ptr,
    .param .u64 dA_cumsum_ptr,
    .param .u64 seq_idx_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
{
    .reg .pred %p0, %pw, %p, %acc;
    .reg .b32 %r<64>, %v<16>, %out<64>, %bp<4>;
    .reg .b64 %rd<24>, %ad, %bd, %z<4>, %zs;
    .reg .b16 %h<8>;
    .reg .f32 %last, %a<8>, %dt<8>, %f<8>, %scale, %bs<4>;

    // Bijectively reorder the grid so adjacent heads access nearby input data.
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %ctaid.y;
    mov.u32 %r2, %ctaid.z;
    mad.lo.u32 %r1, %r2, 512, %r1;
    and.b32 %r2, %r1, 7;
    shr.u32 %r3, %r1, 6;
    shr.u32 %r4, %r1, 3;
    and.b32 %r4, %r4, 7;
    shr.u32 %r5, %r2, 1;

    // Resolve the input and float32 output pointers using byte strides.
    ld.param.u64 %rd0, [x_ptr];
    ld.param.u64 %rd1, [b_ptr];
    ld.param.u64 %rd2, [states_ptr];
    ld.param.u64 %rd3, [dt_ptr];
    ld.param.u64 %rd4, [dA_cumsum_ptr];
    shl.b32 %r6, %r3, 21;
    mad.lo.u32 %r6, %r4, 262144, %r6;
    mad.lo.u32 %r7, %r2, 128, %r6;
    cvt.u64.u32 %rd5, %r7;
    add.u64 %rd0, %rd0, %rd5;
    mad.lo.u32 %r7, %r5, 256, %r6;
    cvt.u64.u32 %rd5, %r7;
    add.u64 %rd1, %rd1, %rd5;
    shl.b32 %r6, %r3, 16;
    mad.lo.u32 %r6, %r4, 1024, %r6;
    mad.lo.u32 %r6, %r2, 8192, %r6;
    cvt.u64.u32 %rd5, %r6;
    add.u64 %rd3, %rd3, %rd5;
    add.u64 %rd4, %rd4, %rd5;
    shl.b32 %r6, %r3, 21;
    mad.lo.u32 %r6, %r4, 262144, %r6;
    mad.lo.u32 %r6, %r2, 32768, %r6;
    cvt.u64.u32 %rd5, %r6;
    add.u64 %rd2, %rd2, %rd5;

    // Two operand buffers use bytes 0..49151; metadata ends at byte 49167.
    mov.u32 %r8, global_smem;
    add.u32 %r9, %r8, 49152;
    add.u32 %r10, %r8, 49160;
    setp.eq.u32 %p0, %r0, 0;
    setp.lt.u32 %pw, %r0, 32;
    @%pw tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 [%r9], 128;
    @%pw tcgen05.relinquish_alloc_permit.cta_group::1.sync.aligned;
    @%p0 mbarrier.init.shared::cta.b64 [%r10], 1;

    // Each warp retains all 256 time weights distributed across its lanes.
    ld.global.f32 %last, [%rd4+1020];
    and.b32 %r11, %r0, 31;
    shl.b32 %r12, %r11, 2;
    cvt.u64.u32 %rd5, %r12;
    add.u64 %rd6, %rd3, %rd5;
    add.u64 %rd7, %rd4, %rd5;
    ld.global.f32 %dt0, [%rd6];
    ld.global.f32 %a0, [%rd7];
    ld.global.f32 %dt1, [%rd6+128];
    ld.global.f32 %a1, [%rd7+128];
    ld.global.f32 %dt2, [%rd6+256];
    ld.global.f32 %a2, [%rd7+256];
    ld.global.f32 %dt3, [%rd6+384];
    ld.global.f32 %a3, [%rd7+384];
    ld.global.f32 %dt4, [%rd6+512];
    ld.global.f32 %a4, [%rd7+512];
    ld.global.f32 %dt5, [%rd6+640];
    ld.global.f32 %a5, [%rd7+640];
    ld.global.f32 %dt6, [%rd6+768];
    ld.global.f32 %a6, [%rd7+768];
    ld.global.f32 %dt7, [%rd6+896];
    ld.global.f32 %a7, [%rd7+896];

    // Evaluate dt[k] * exp(min(last - dA[k], 0)) in float32.
    sub.f32 %a0, %last, %a0;
    min.NaN.f32 %a0, %a0, 0f00000000;
    mul.f32 %a0, %a0, 0f3FB8AA3B;
    ex2.approx.ftz.f32 %a0, %a0;
    mul.f32 %a0, %a0, %dt0;
    sub.f32 %a1, %last, %a1;
    min.NaN.f32 %a1, %a1, 0f00000000;
    mul.f32 %a1, %a1, 0f3FB8AA3B;
    ex2.approx.ftz.f32 %a1, %a1;
    mul.f32 %a1, %a1, %dt1;
    sub.f32 %a2, %last, %a2;
    min.NaN.f32 %a2, %a2, 0f00000000;
    mul.f32 %a2, %a2, 0f3FB8AA3B;
    ex2.approx.ftz.f32 %a2, %a2;
    mul.f32 %a2, %a2, %dt2;
    sub.f32 %a3, %last, %a3;
    min.NaN.f32 %a3, %a3, 0f00000000;
    mul.f32 %a3, %a3, 0f3FB8AA3B;
    ex2.approx.ftz.f32 %a3, %a3;
    mul.f32 %a3, %a3, %dt3;
    sub.f32 %a4, %last, %a4;
    min.NaN.f32 %a4, %a4, 0f00000000;
    mul.f32 %a4, %a4, 0f3FB8AA3B;
    ex2.approx.ftz.f32 %a4, %a4;
    mul.f32 %a4, %a4, %dt4;
    sub.f32 %a5, %last, %a5;
    min.NaN.f32 %a5, %a5, 0f00000000;
    mul.f32 %a5, %a5, 0f3FB8AA3B;
    ex2.approx.ftz.f32 %a5, %a5;
    mul.f32 %a5, %a5, %dt5;
    sub.f32 %a6, %last, %a6;
    min.NaN.f32 %a6, %a6, 0f00000000;
    mul.f32 %a6, %a6, 0f3FB8AA3B;
    ex2.approx.ftz.f32 %a6, %a6;
    mul.f32 %a6, %a6, %dt6;
    sub.f32 %a7, %last, %a7;
    min.NaN.f32 %a7, %a7, 0f00000000;
    mul.f32 %a7, %a7, 0f3FB8AA3B;
    ex2.approx.ftz.f32 %a7, %a7;
    mul.f32 %a7, %a7, %dt7;
    bar.sync 0;
    ld.shared.u32 %r13, [%r9];
    mov.u32 %r14, 0;
    mov.u32 %r15, 0;
    mov.u32 %r37, 0;

PIPELINE:
    // Prefetch the next K=64 stage; the final iteration only drains the pipeline.
    setp.lt.u32 %p, %r14, 256;
    @!%p bra COPY_DONE;
    add.u32 %r38, %r8, %r37;
    and.b32 %r16, %r0, 7;
    shl.b32 %r16, %r16, 4;
    shr.u32 %r17, %r0, 3;
    shl.b32 %r18, %r17, 7;
    add.u32 %r18, %r18, %r16;
    shl.b32 %r19, %r17, 4;
    xor.b32 %r18, %r18, %r19;
    add.u32 %r18, %r18, %r38;
    add.u32 %r20, %r17, %r14;
    shl.b32 %r20, %r20, 10;
    add.u32 %r20, %r20, %r16;
    cvt.u64.u32 %rd5, %r20;
    add.u64 %rd8, %rd0, %rd5;

    // Copy all 64 by 64 X values into a 128-byte-swizzled shared tile.
    cp.async.cg.shared.global [%r18], [%rd8], 16;
    cp.async.cg.shared.global [%r18+1024], [%rd8+8192], 16;
    cp.async.cg.shared.global [%r18+2048], [%rd8+16384], 16;
    cp.async.cg.shared.global [%r18+3072], [%rd8+24576], 16;
    cp.async.cg.shared.global [%r18+4096], [%rd8+32768], 16;
    cp.async.cg.shared.global [%r18+5120], [%rd8+40960], 16;
    cp.async.cg.shared.global [%r18+6144], [%rd8+49152], 16;
    cp.async.cg.shared.global [%r18+7168], [%rd8+57344], 16;

    // Map coalesced B vectors into two swizzled N=64 panels.
    and.b32 %r16, %r0, 15;
    shl.b32 %r16, %r16, 4;
    shr.u32 %r17, %r0, 4;
    add.u32 %r20, %r17, %r14;
    shl.b32 %r20, %r20, 10;
    add.u32 %r20, %r20, %r16;
    cvt.u64.u32 %rd5, %r20;
    add.u64 %rd8, %rd1, %rd5;
    and.b32 %r22, %r16, 127;
    and.b32 %r23, %r16, 128;
    shl.b32 %r23, %r23, 6;
    mad.lo.u32 %r22, %r17, 128, %r22;
    shl.b32 %r24, %r17, 4;
    xor.b32 %r22, %r22, %r24;
    add.u32 %r22, %r22, %r23;
    add.u32 %r22, %r22, 8192;
    add.u32 %r36, %r22, %r38;
    xor.b32 %r22, %r36, 64;
    cp.async.cg.shared.global [%r36], [%rd8], 16;
    cp.async.cg.shared.global [%r22+512], [%rd8+4096], 16;
    cp.async.cg.shared.global [%r36+1024], [%rd8+8192], 16;
    cp.async.cg.shared.global [%r22+1536], [%rd8+12288], 16;
    cp.async.cg.shared.global [%r36+2048], [%rd8+16384], 16;
    cp.async.cg.shared.global [%r22+2560], [%rd8+20480], 16;
    cp.async.cg.shared.global [%r36+3072], [%rd8+24576], 16;
    cp.async.cg.shared.global [%r22+3584], [%rd8+28672], 16;
    cp.async.cg.shared.global [%r36+4096], [%rd8+32768], 16;
    cp.async.cg.shared.global [%r22+4608], [%rd8+36864], 16;
    cp.async.cg.shared.global [%r36+5120], [%rd8+40960], 16;
    cp.async.cg.shared.global [%r22+5632], [%rd8+45056], 16;
    cp.async.cg.shared.global [%r36+6144], [%rd8+49152], 16;
    cp.async.cg.shared.global [%r22+6656], [%rd8+53248], 16;
    cp.async.cg.shared.global [%r36+7168], [%rd8+57344], 16;
    cp.async.cg.shared.global [%r22+7680], [%rd8+61440], 16;
COPY_DONE:
    cp.async.commit_group;
    setp.eq.u32 %p, %r14, 0;
    @%p bra ADVANCE;

    // Each thread consumes exactly its own completed B copies.
    cp.async.wait_group 1;
    xor.b32 %r38, %r37, 24576;
    add.u32 %r38, %r38, %r8;
    and.b32 %r16, %r0, 15;
    shl.b32 %r16, %r16, 4;
    shr.u32 %r17, %r0, 4;
    and.b32 %r22, %r16, 127;
    and.b32 %r23, %r16, 128;
    shl.b32 %r23, %r23, 6;
    mad.lo.u32 %r22, %r17, 128, %r22;
    shl.b32 %r24, %r17, 4;
    xor.b32 %r22, %r22, %r24;
    add.u32 %r22, %r22, %r23;
    add.u32 %r22, %r22, 8192;
    add.u32 %bp0, %r22, %r38;
    add.u32 %bp1, %bp0, 512;
    xor.b32 %bp1, %bp1, 64;
    add.u32 %bp2, %bp0, 1024;
    add.u32 %bp3, %bp0, 1536;
    xor.b32 %bp3, %bp3, 64;
    mov.u32 %r21, %r17;
SCALE_B:
    // Load four vectors and broadcast the corresponding time weights.
    ld.shared.v4.b32 {%v0,%v1,%v2,%v3}, [%bp0];
    ld.shared.v4.b32 {%v4,%v5,%v6,%v7}, [%bp1];
    ld.shared.v4.b32 {%v8,%v9,%v10,%v11}, [%bp2];
    ld.shared.v4.b32 {%v12,%v13,%v14,%v15}, [%bp3];
    setp.ge.u32 %p, %r21, 32;
    selp.f32 %scale, %a1, %a0, %p;
    and.b32 %r22, %r21, 31;
    shfl.sync.idx.b32 %bs0, %scale, %r22, 31, -1;
    add.u32 %r22, %r22, 4;
    shfl.sync.idx.b32 %bs1, %scale, %r22, 31, -1;
    add.u32 %r22, %r22, 4;
    shfl.sync.idx.b32 %bs2, %scale, %r22, 31, -1;
    add.u32 %r22, %r22, 4;
    shfl.sync.idx.b32 %bs3, %scale, %r22, 31, -1;

    // Scale the first vector in float32, then round each result to half.
    mov.b32 {%h0,%h1}, %v0;
    mov.b32 {%h2,%h3}, %v1;
    mov.b32 {%h4,%h5}, %v2;
    mov.b32 {%h6,%h7}, %v3;
    cvt.f32.f16 %f0, %h0;
    cvt.f32.f16 %f1, %h1;
    cvt.f32.f16 %f2, %h2;
    cvt.f32.f16 %f3, %h3;
    cvt.f32.f16 %f4, %h4;
    cvt.f32.f16 %f5, %h5;
    cvt.f32.f16 %f6, %h6;
    cvt.f32.f16 %f7, %h7;
    mov.b64 %zs, {%bs0,%bs0};
    mov.b64 %z0, {%f0,%f1};
    mul.rn.f32x2 %z0, %z0, %zs;
    mov.b64 {%f0,%f1}, %z0;
    cvt.rn.f16x2.f32 %v0, %f1, %f0;
    mov.b64 %z1, {%f2,%f3};
    mul.rn.f32x2 %z1, %z1, %zs;
    mov.b64 {%f2,%f3}, %z1;
    cvt.rn.f16x2.f32 %v1, %f3, %f2;
    mov.b64 %z2, {%f4,%f5};
    mul.rn.f32x2 %z2, %z2, %zs;
    mov.b64 {%f4,%f5}, %z2;
    cvt.rn.f16x2.f32 %v2, %f5, %f4;
    mov.b64 %z3, {%f6,%f7};
    mul.rn.f32x2 %z3, %z3, %zs;
    mov.b64 {%f6,%f7}, %z3;
    cvt.rn.f16x2.f32 %v3, %f7, %f6;
    st.shared.v4.b32 [%bp0], {%v0,%v1,%v2,%v3};

    // Scale and round the second vector.
    mov.b32 {%h0,%h1}, %v4;
    mov.b32 {%h2,%h3}, %v5;
    mov.b32 {%h4,%h5}, %v6;
    mov.b32 {%h6,%h7}, %v7;
    cvt.f32.f16 %f0, %h0;
    cvt.f32.f16 %f1, %h1;
    cvt.f32.f16 %f2, %h2;
    cvt.f32.f16 %f3, %h3;
    cvt.f32.f16 %f4, %h4;
    cvt.f32.f16 %f5, %h5;
    cvt.f32.f16 %f6, %h6;
    cvt.f32.f16 %f7, %h7;
    mov.b64 %zs, {%bs1,%bs1};
    mov.b64 %z0, {%f0,%f1};
    mul.rn.f32x2 %z0, %z0, %zs;
    mov.b64 {%f0,%f1}, %z0;
    cvt.rn.f16x2.f32 %v4, %f1, %f0;
    mov.b64 %z1, {%f2,%f3};
    mul.rn.f32x2 %z1, %z1, %zs;
    mov.b64 {%f2,%f3}, %z1;
    cvt.rn.f16x2.f32 %v5, %f3, %f2;
    mov.b64 %z2, {%f4,%f5};
    mul.rn.f32x2 %z2, %z2, %zs;
    mov.b64 {%f4,%f5}, %z2;
    cvt.rn.f16x2.f32 %v6, %f5, %f4;
    mov.b64 %z3, {%f6,%f7};
    mul.rn.f32x2 %z3, %z3, %zs;
    mov.b64 {%f6,%f7}, %z3;
    cvt.rn.f16x2.f32 %v7, %f7, %f6;
    st.shared.v4.b32 [%bp1], {%v4,%v5,%v6,%v7};

    // Scale and round the third vector.
    mov.b32 {%h0,%h1}, %v8;
    mov.b32 {%h2,%h3}, %v9;
    mov.b32 {%h4,%h5}, %v10;
    mov.b32 {%h6,%h7}, %v11;
    cvt.f32.f16 %f0, %h0;
    cvt.f32.f16 %f1, %h1;
    cvt.f32.f16 %f2, %h2;
    cvt.f32.f16 %f3, %h3;
    cvt.f32.f16 %f4, %h4;
    cvt.f32.f16 %f5, %h5;
    cvt.f32.f16 %f6, %h6;
    cvt.f32.f16 %f7, %h7;
    mov.b64 %zs, {%bs2,%bs2};
    mov.b64 %z0, {%f0,%f1};
    mul.rn.f32x2 %z0, %z0, %zs;
    mov.b64 {%f0,%f1}, %z0;
    cvt.rn.f16x2.f32 %v8, %f1, %f0;
    mov.b64 %z1, {%f2,%f3};
    mul.rn.f32x2 %z1, %z1, %zs;
    mov.b64 {%f2,%f3}, %z1;
    cvt.rn.f16x2.f32 %v9, %f3, %f2;
    mov.b64 %z2, {%f4,%f5};
    mul.rn.f32x2 %z2, %z2, %zs;
    mov.b64 {%f4,%f5}, %z2;
    cvt.rn.f16x2.f32 %v10, %f5, %f4;
    mov.b64 %z3, {%f6,%f7};
    mul.rn.f32x2 %z3, %z3, %zs;
