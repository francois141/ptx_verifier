    // Use M=128 with aliased duplicate A rows and mask the unused tensor lanes.
    @!%p0 bra MMA_DONE;
    shr.u32 %r25, %r38, 4;
    cvt.u64.u32 %ad, %r25;
    add.u64 %ad, %ad, 0x4000404000000000;
    add.u64 %bd, %ad, 0x02000200;
    mov.u32 %r26, 0x08218010;
    mov.u32 %r44, 0;
    mov.u32 %r45, -1;
    setp.ne.u32 %acc, %r14, 64;
    tcgen05.mma.cta_group::1.kind::f16 [%r13], %ad, %bd, %r26, {%r44,%r44,%r45,%r45}, %acc;
    add.u64 %ad, %ad, 128;
    add.u64 %bd, %bd, 128;
    setp.eq.u32 %acc, %r0, 0;
    tcgen05.mma.cta_group::1.kind::f16 [%r13], %ad, %bd, %r26, {%r44,%r44,%r45,%r45}, %acc;
    add.u64 %ad, %ad, 128;
    add.u64 %bd, %bd, 128;
    tcgen05.mma.cta_group::1.kind::f16 [%r13], %ad, %bd, %r26, {%r44,%r44,%r45,%r45}, %acc;
    add.u64 %ad, %ad, 128;
    add.u64 %bd, %bd, 128;
    tcgen05.mma.cta_group::1.kind::f16 [%r13], %ad, %bd, %r26, {%r44,%r44,%r45,%r45}, %acc;
    tcgen05.commit.cta_group::1.mbarrier::arrive::one.shared::cluster.b64 [%r10];
