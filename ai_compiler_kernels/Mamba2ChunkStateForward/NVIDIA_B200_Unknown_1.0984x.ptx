    xor.b32 %r15, %r15, 1;
    mov.f32 %a0, %a2;
    mov.f32 %a1, %a3;
    mov.f32 %a2, %a4;
    mov.f32 %a3, %a5;
    mov.f32 %a4, %a6;
    mov.f32 %a5, %a7;
ADVANCE:
    add.u32 %r14, %r14, 64;
