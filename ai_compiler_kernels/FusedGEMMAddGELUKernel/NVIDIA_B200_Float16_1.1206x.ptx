 mov.b64 {%a6,%a7},%R3; cvt.rn.f16x2.f32 %o3,%a7,%a6;
 st.global.v4.b32 [%gc],{%o0,%o1,%o2,%o3};
 // Advance eight rows, collectively covering the entire 128 by 128 tile.
 add.u32 %roff,%roff,4096; add.u32 %ds,%ds,2048; add.u64 %gc,%gc,65536;
 add.u32 %outiter,%outiter,1; setp.lt.u32 %loop,%outiter,16;
 @%loop bra EPILOGUE;
 ret;
}
