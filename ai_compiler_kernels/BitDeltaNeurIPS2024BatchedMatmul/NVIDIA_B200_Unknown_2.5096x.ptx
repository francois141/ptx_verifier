add.u32 %in,%s,%x;
add.u32 %x,%m,%row;
mad.lo.u32 %x,%batch,4096,%x;
shl.b32 %x,%x,12;
add.u32 %x,%x,%n;
mad.lo.u32 %x,%lane,8,%x;
mul.wide.u32 %off,%x,2;
add.u64 %gc,%cp,%off;
mov.u32 %copy,0;
COPY_OUTPUT:
ld.shared.v4.b32 {%h0,%h1,%h2,%h3},[%in];
st.global.v4.b32 [%gc],{%h0,%h1,%h2,%h3};
add.u32 %in,%in,2048;
xor.b32 %in,%in,64;
add.u64 %gc,%gc,32768;
add.u32 %copy,%copy,1;
setp.lt.u32 %more,%copy,32;
@%more bra COPY_OUTPUT;
ret;
}