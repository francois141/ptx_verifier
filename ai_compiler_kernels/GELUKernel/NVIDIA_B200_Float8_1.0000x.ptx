*/
.global .align 16 .u16 gelu_lut[256] = {0,5122,6147,6663,7174,7434,7694,7956,8205,8336,8468,8600,8733,8866,8999,9133,9242,9376,9512,9648,9785,9923,10062,10202,10291,10433,10576,10720,10867,11015,11164,11290,11366,11521,11679,11840,12004,12172,12315,12402,12490,12671,12858,13051,13249,13382,13487,13594,13704,13931,14167,14374,14500,14629,14762,14897,15035,15316,15481,15625,15769,15913,16056,16198,16337,16498,16632,16764,16894,17023,17152,17280,17408,17536,17664,17792,17920,18048,18176,18304,18432,18560,18688,18816,18944,19072,19200,19328,19456,19584,19712,19840,19968,20096,20224,20352,20480,20608,20736,20864,20992,21120,21248,21376,21504,21632,21760,21888,22016,22144,22272,22400,22528,22656,22784,22912,23040,23168,23296,23424,23552,23680,23808,23936,24064,24192,24320,32256,32768,37885,38906,39417,39923,40182,40434,40684,40934,41072,41196,41320,41443,41566,41689,41811,41933,42080,42200,42320,42439,42557,42674,42790,42906,43071,43184,43296,43405,43513,43620,43725,43828,44030,44129,44224,44316,44404,44490,44572,44652,44802,44940,45061,45119,45171,45218,45259,45296,45354,45394,45417,45424,45418,45400,45370,45332,45233,45114,44913,44650,44395,44157,43852,43475,42763,41971,41010,39974,38830,37548,36207,34855,33024,32793,32771,32768,32768,32768,32768, 32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768, 32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768, 32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32256};
.visible .entry kernel(
    .param .u64 x_ptr,
    .param .u64 output_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
{
    .reg .b32 %r<16>;
    .reg .b64 %d<12>;
    .reg .b16 %h<4>;

    // Four adjacent elements per thread cover the unmasked 1024-element tile.
    ld.param.u64 %d0, [x_ptr];
    ld.param.u64 %d1, [output_ptr];
    mov.u32 %r0, %ctaid.x;
    mov.u32 %r1, %tid.x;
    shl.b32 %r2, %r0, 10;
    mad.lo.u32 %r2, %r1, 4, %r2;

    // Form input, output, and read-only lookup addresses.
    cvta.global.u64 %d2, gelu_lut;
    mul.wide.u32 %d3, %r2, 1;
    add.u64 %d4, %d0, %d3;
    mul.wide.u32 %d5, %r2, 2;
    add.u64 %d5, %d1, %d5;

    // Extract four FP8 encodings from one aligned load.
    ld.global.u32 %r3, [%d4];
    bfe.u32 %r4, %r3, 0, 8;
    bfe.u32 %r5, %r3, 8, 8;
    bfe.u32 %r6, %r3, 16, 8;
    bfe.u32 %r7, %r3, 24, 8;

    // Lookup rounded GELU values, keeping the small table resident in L1.
    mul.wide.u32 %d6, %r4, 2;
    mul.wide.u32 %d7, %r5, 2;
    mul.wide.u32 %d8, %r6, 2;
    mul.wide.u32 %d9, %r7, 2;
    add.u64 %d6, %d2, %d6;
    add.u64 %d7, %d2, %d7;
    add.u64 %d8, %d2, %d8;
    add.u64 %d9, %d2, %d9;
    ld.global.L1::evict_last.u16 %h0, [%d6];
    ld.global.L1::evict_last.u16 %h1, [%d7];
    ld.global.L1::evict_last.u16 %h2, [%d8];
    ld.global.L1::evict_last.u16 %h3, [%d9];

    // Pack and store four contiguous FP16 results.
    mov.b32 %r8, {%h0, %h1};
    mov.b32 %r9, {%h2, %h3};
    st.global.v2.u32 [%d5], {%r8, %r9};
    ret;
}