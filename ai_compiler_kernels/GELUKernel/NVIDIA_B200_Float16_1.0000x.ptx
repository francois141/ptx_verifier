.version 8.7
.target sm_100a
.address_size 64
.extern .shared .align 16 .b8 global_smem[];
// Evaluate GELU in float32 before rounding to half precision.
.func (.param .b32 out) gelu(.param .b32 in)
{
 .reg .b32 %bits;
 .reg .b16 %h, %unused, %o;
 .reg .f32 %v, %z, %t, %p, %e, %r, %s;
 .reg .pred %neg;
 ld.param.b32 %bits, [in];
 mov.b32 {%h, %unused}, %bits;
 cvt.f32.f16 %v, %h;
 // Approximate erf using a reciprocal polynomial and an exponential.
 mul.f32 %z, %v, 0f3F3504F3;
 setp.lt.f32 %neg, %z, 0f00000000;
 abs.f32 %z, %z;
 fma.rn.f32 %t, %z, 0f3EA7BA05, 0f3F800000;
 rcp.approx.ftz.f32 %t, %t;
 mov.f32 %p, 0f3F87DC22;
 fma.rn.f32 %p, %p, %t, 0fBFBA00E3;
 fma.rn.f32 %p, %p, %t, 0f3FB5F0E3;
 fma.rn.f32 %p, %p, %t, 0fBE91A98E;
 fma.rn.f32 %p, %p, %t, 0f3E827906;
 mul.f32 %p, %p, %t;
 mul.f32 %e, %z, %z;
 mul.f32 %e, %e, 0fBFB8AA3B;
 ex2.approx.ftz.f32 %e, %e;
 neg.f32 %p, %p;
 fma.rn.f32 %r, %p, %e, 0f3F800000;
 neg.f32 %s, %r;
 selp.f32 %r, %s, %r, %neg;
 // Preserve the float32 addition and product before the half conversion.
 add.f32 %r, %r, 0f3F800000;
 mul.f32 %v, %v, 0f3F000000;
 mul.f32 %r, %v, %r;
 cvt.rn.f16.f32 %o, %r;
 mov.b32 %bits, {%o, %unused};
 st.param.b32 [out], %bits;
 ret;
}
.visible .entry kernel(
 .param .u64 x_ptr,
 .param .u64 output_ptr,
 .param .u64 dummy_ptr1,
 .param .u64 dummy_ptr2
){
 .reg .b64 %x, %y, %off, %a, %b;
 .reg .b32 %lane, %pid, %idx, %v<4>, %r<4>, %pack<2>;
 .reg .b16 %h<4>, %u;
 .param .b32 arg, res;
 // Each thread handles four adjacent halves, covering exactly 1024 elements.
 ld.param.u64 %x, [x_ptr];
 ld.param.u64 %y, [output_ptr];
 mov.u32 %lane, %tid.x;
 mov.u32 %pid, %ctaid.x;
 mad.lo.u32 %idx, %pid, 256, %lane;
 mul.wide.u32 %off, %idx, 8;
 add.u64 %a, %x, %off;
 add.u64 %b, %y, %off;
 // Load four contiguous half values in a single vector load.
 ld.global.v2.b32 {%v0, %v2}, [%a];
 shr.u32 %v1, %v0, 16;
 shr.u32 %v3, %v2, 16;
 // Independent evaluations allow instruction-level parallelism after inlining.
 st.param.b32 [arg], %v0;
 call.uni (res), gelu, (arg);
 ld.param.b32 %r0, [res];
 st.param.b32 [arg], %v1;
 call.uni (res), gelu, (arg);
 ld.param.b32 %r1, [res];
 st.param.b32 [arg], %v2;
 call.uni (res), gelu, (arg);
 ld.param.b32 %r2, [res];
 st.param.b32 [arg], %v3;
 call.uni (res), gelu, (arg);
 ld.param.b32 %r3, [res];
 // Pack the results and issue a vector store.
 mov.b32 {%h0, %u}, %r0;
 mov.b32 {%h1, %u}, %r1;
 mov.b32 {%h2, %u}, %r2;
 mov.b32 {%h3, %u}, %r3;
 mov.b32 %pack0, {%h0, %h1};
 mov.b32 %pack1, {%h2, %h3};
 st.global.v2.b32 [%b], {%pack0, %pack1};
 ret;
}