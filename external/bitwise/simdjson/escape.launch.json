{
  "description": "simdjson's escape scanner: 8 independent 32-character blocks; escaped marks the characters a backslash escapes, unescaped_quote the quotes that are not escaped",
  "kernel": "escape",
  "block": [8, 1, 1],
  "grid": [1, 1, 1],
  "arrays": [
    {"name": "backslash", "kind": "in", "dtype": "i32", "shape": [8]},
    {"name": "quote", "kind": "in", "dtype": "i32", "shape": [8]},
    {"name": "escaped", "kind": "out", "dtype": "i32", "shape": [8]},
    {"name": "unescaped_quote", "kind": "out", "dtype": "i32", "shape": [8]}
  ],
  "params": [
    {"name": "backslash", "ptr": "backslash"},
    {"name": "quote", "ptr": "quote"},
    {"name": "escaped", "ptr": "escaped"},
    {"name": "unescaped_quote", "ptr": "unescaped_quote"}
  ],
  "spec": "escape.spec",
  "dims": {"B": 8}
}
