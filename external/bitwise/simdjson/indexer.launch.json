{
  "description": "simdjson's structural indexer offsets: 4 rows of 4 32-character blocks, one thread per block; offset is where a block's structural indices start in the row's tape, total the row's count",
  "kernel": "indexer",
  "block": [4, 4, 1],
  "grid": [1, 1, 1],
  "arrays": [
    {"name": "start", "kind": "in", "dtype": "i32", "shape": [4, 4]},
    {"name": "offset", "kind": "out", "dtype": "i32", "shape": [4, 4]},
    {"name": "total", "kind": "out", "dtype": "i32", "shape": [4]}
  ],
  "params": [
    {"name": "start", "ptr": "start"},
    {"name": "offset", "ptr": "offset"},
    {"name": "total", "ptr": "total"},
    {"name": "words", "int": 4}
  ],
  "spec": "indexer.spec",
  "dims": {"R": 4, "W": 4}
}
