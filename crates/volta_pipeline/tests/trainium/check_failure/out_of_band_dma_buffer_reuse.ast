kernel kernel(a: [2, 4], out: [2, 4])
  x: sbuf[1, 4] of a.dtype
  dma_copy(dge_mode=nki.isa.dge_mode.none, dst=x, src=a[0:1, :])
  dma_copy(dge_mode=nki.isa.dge_mode.none, dst=out[0:1, :], src=x)
  dma_copy(dge_mode=nki.isa.dge_mode.none, dst=x, src=a[1:2, :])
  dma_copy(dge_mode=nki.isa.dge_mode.none, dst=out[1:2, :], src=x)
