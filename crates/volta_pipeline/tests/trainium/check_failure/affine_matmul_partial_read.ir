kernel kernel(a_t, b, out)
  a_t: hbm[4, 2]
  b: hbm[4, 3]
  out: hbm[4, 3]
  acc: psum[2, 3]
  x.0: sbuf[2, 2]
  y.0: sbuf[2, 3]
  partial.0: sbuf[2, 3]
  x.1: sbuf[2, 2]
  y.1: sbuf[2, 3]
  partial.1: sbuf[2, 3]
  x.0 = dma(a_t[0:2, 0:2])  # in affine_range#0[0]
  y.0 = dma(b[0:2, 0:3])  # in affine_range#0[0]
  acc = matmul(x.0, y.0)  # in affine_range#0[0]
  partial.0 = mov(acc)  # in affine_range#0[0]
  out[0:2, 0:3] = dma(partial.0)  # in affine_range#0[0]
  x.1 = dma(a_t[2:4, 0:2])  # in affine_range#0[1]
  y.1 = dma(b[2:4, 0:3])  # in affine_range#0[1]
  acc = matmul(x.1, y.1)  # in affine_range#0[1]
  partial.1 = mov(acc)  # in affine_range#0[1]
  out[2:4, 0:3] = dma(partial.1)  # in affine_range#0[1]
