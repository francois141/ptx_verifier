kernel kernel(a_t: [4, 2], b: [4, 3], out: [4, 3])
  acc: psum[2, 3] of float32
  x.0: sbuf[2, 2] of a_t.dtype
  dma_copy(dst=x.0, src=a_t[0:2, :])  # in affine_range#0[0]
  y.0: sbuf[2, 3] of b.dtype
  dma_copy(dst=y.0, src=b[0:2, :])  # in affine_range#0[0]
  nc_matmul(dst=acc, moving=y.0, stationary=x.0)  # in affine_range#0[0]
  partial.0: sbuf[2, 3] of float32
  tensor_copy(dst=partial.0, src=acc)  # in affine_range#0[0]
  dma_copy(dst=out[0:2, :], src=partial.0)  # in affine_range#0[0]
  x.1: sbuf[2, 2] of a_t.dtype
  dma_copy(dst=x.1, src=a_t[2:4, :])  # in affine_range#0[1]
  y.1: sbuf[2, 3] of b.dtype
  dma_copy(dst=y.1, src=b[2:4, :])  # in affine_range#0[1]
  nc_matmul(dst=acc, moving=y.1, stationary=x.1)  # in affine_range#0[1]
  partial.1: sbuf[2, 3] of float32
  tensor_copy(dst=partial.1, src=acc)  # in affine_range#0[1]
  dma_copy(dst=out[2:4, :], src=partial.1)  # in affine_range#0[1]
