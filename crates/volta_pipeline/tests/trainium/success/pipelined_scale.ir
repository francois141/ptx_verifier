kernel kernel(a) -> out
  a: hbm[6, 4]
  out: hbm[6, 4]
  tiles: sbuf[2, 2, 4]
  scaled: sbuf[2, 2, 4]
  tiles[0:2, 0, 0:4] = dma(a[0:2, 0:4])  # in for#2[0] > no_reorder#0
  scaled[0:2, 0, 0:4] = multiply(tiles[0:2, 0, 0:4], 2)  # in for#2[1] > no_reorder#0
  tiles[0:2, 1, 0:4] = dma(a[2:4, 0:4])  # in for#2[1] > no_reorder#0
  out[0:2, 0:4] = dma(scaled[0:2, 0, 0:4])  # in for#2[2] > no_reorder#0
  scaled[0:2, 1, 0:4] = multiply(tiles[0:2, 1, 0:4], 2)  # in for#2[2] > no_reorder#0
  tiles[0:2, 0, 0:4] = dma(a[4:6, 0:4])  # in for#2[2] > no_reorder#0
  out[2:4, 0:4] = dma(scaled[0:2, 1, 0:4])  # in for#2[3] > no_reorder#0
  scaled[0:2, 0, 0:4] = multiply(tiles[0:2, 0, 0:4], 2)  # in for#2[3] > no_reorder#0
  out[4:6, 0:4] = dma(scaled[0:2, 0, 0:4])  # in for#2[4] > no_reorder#0
