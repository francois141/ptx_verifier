kernel kernel(a, b, c) -> out
  a: hbm[2, 3]
  b: hbm[1, 3]
  c: hbm[2, 1]
  out: hbm[2, 9]
  x: sbuf[2, 3]
  row: sbuf[1, 3]
  scale: sbuf[2, 1]
  rows_b: sbuf[2, 3]
  forward: sbuf[2, 3]
  reversed: sbuf[2, 3]
  scaled: sbuf[2, 3]
  x = dma(a)
  row = dma(b)
  scale = memset(0)
  scale = dma(c)
  rows_b = mov(row.ap([[0, 2], [1, 3]], offset=0))
  forward = scan(acc = scale; acc = add(multiply(x, acc), rows_b))
  reversed = scan(acc = 1; acc = subtract(rows_b, subtract(acc, x)))
  scaled = exp(multiply(x, scale))
  out[0:2, 0:3] = dma(forward)
  out[0:2, 3:6] = dma(reversed)
  out[0:2, 6:9] = dma(scaled)
