kernel kernel(a: [8, 4], out: [8, 4])
  x.0: sbuf[4, 4] of a.dtype
  dma_copy(dst=x.0, src=a[0:4, :])  # in affine_range#0[0]
  dma_copy(dst=out[0:4, :], src=x.0)  # in affine_range#0[0]
  x.1: sbuf[4, 4] of a.dtype
  dma_copy(dst=x.1, src=a[4:8, :])  # in affine_range#0[1]
  dma_copy(dst=out[4:8, :], src=x.1)  # in affine_range#0[1]
