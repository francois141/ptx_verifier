kernel kernel(a, b) -> kernel_out
  a: hbm[2, 4]
  b: hbm[2, 4]
  kernel_out: hbm[2, 4]
  x.0: sbuf[2, 2]
  y.0: sbuf[2, 2]
  z.0: sbuf[2, 2]
  x.1: sbuf[2, 2]
  y.1: sbuf[2, 2]
  z.1: sbuf[2, 2]
  x.0 = mov(a[0:2, 0:2])
  y.0 = mov(b[0:2, 0:2])
  z.0 = add(x.0, y.0)
  kernel_out[0:2, 0:2] = mov(z.0)
  x.1 = mov(a[0:2, 2:4])
  y.1 = mov(b[0:2, 2:4])
  z.1 = add(x.1, y.1)
  kernel_out[0:2, 2:4] = mov(z.1)
