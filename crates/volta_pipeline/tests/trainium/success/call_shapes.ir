kernel kernel(a, b) -> kernel_out
  a: hbm[2, 4]
  b: hbm[2, 4]
  kernel_out: hbm[2, 4]
  x.0: sbuf[2, 2]
  y.0: sbuf[2, 2]
  z.0: sbuf[2, 2]
  x.1: sbuf[2, 2]
  y.1: sbuf[2, 2]
  z.1: sbuf[2, 2]
  x.0 = dma(a[0:2, 0:2])  # in affine_range#0[0]
  y.0 = dma(b[0:2, 0:2])  # in affine_range#0[0]
  z.0 = add(x.0, y.0)  # in affine_range#0[0]
  kernel_out[0:2, 0:2] = dma(z.0)  # in affine_range#0[0]
  x.1 = dma(a[0:2, 2:4])  # in affine_range#0[1]
  y.1 = dma(b[0:2, 2:4])  # in affine_range#0[1]
  z.1 = add(x.1, y.1)  # in affine_range#0[1]
  kernel_out[0:2, 2:4] = dma(z.1)  # in affine_range#0[1]
