kernel kernel(x: [2, 4])
  kernel_out: shared_hbm[2, 4] of x.dtype
  data: sbuf[2, 4] of x.dtype
  dma_copy(dst=data, src=x)
  copy: sbuf[2, 2, 2] of float32
  chunk_max: sbuf[2, 2] of float32
  tensor_scalar_reduce(data=data[:, 0:2], dst=copy[:, 0, :], op0=nki.language.multiply, operand0=1, reduce_op=nki.language.maximum, reduce_res=chunk_max[:, 0:1])
  tensor_scalar_reduce(data=data[:, 2:4], dst=copy[:, 1, :], op0=nki.language.multiply, operand0=1, reduce_op=nki.language.maximum, reduce_res=chunk_max[:, 1:2])
  neg_max: sbuf[2, 1] of float32
  tensor_reduce(axis=(1,), data=chunk_max, dst=neg_max, negate=True, op=nki.language.maximum)
  exp_vals: sbuf[2, 4] of bfloat16
  chunk_sum: sbuf[2, 2] of float32
  activation(bias=neg_max, data=copy[:, 0, :], dst=exp_vals[:, 0:2], op=nki.language.exp, reduce_cmd=nki.isa.reduce_cmd.reset_reduce, reduce_op=nki.language.add, reduce_res=chunk_sum[:, 0:1])
  activation(bias=neg_max, data=copy[:, 1, :], dst=exp_vals[:, 2:4], op=nki.language.exp, reduce_cmd=nki.isa.reduce_cmd.reset_reduce, reduce_op=nki.language.add, reduce_res=chunk_sum[:, 1:2])
  row_sum: sbuf[2, 1] of float32
  tensor_reduce(axis=(1,), data=chunk_sum, dst=row_sum, op=nki.language.add)
  inv_sum: sbuf[2, 1] of float32
  reciprocal(data=row_sum, dst=inv_sum)
  result: sbuf[2, 4] of float32
  tensor_scalar(data=exp_vals, dst=result, op0=nki.language.multiply, operand0=inv_sum)
  dma_copy(dst=kernel_out, src=result)
  return kernel_out
