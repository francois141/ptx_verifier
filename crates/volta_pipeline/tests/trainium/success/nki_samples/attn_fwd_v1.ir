kernel attn_fwd_v1(q, k, v) -> kernel_out
  q: hbm[128, 128]
  k: hbm[128, 128]
  v: hbm[128, 128]
  kernel_out: hbm[128, 128]
  q_sbuf: sbuf[128, 128]
  k_sbuf: sbuf[128, 128]
  v_sbuf: sbuf[128, 128]
  qk_psum: psum[128, 128]
  qk: sbuf[128, 128]
  row_max: sbuf[128, 1]
  norm_row: sbuf[128, 128]
  exp_row: sbuf[128, 128]
  sum_row: sbuf[128, 1]
  inverse_sum_row: sbuf[128, 1]
  scores: sbuf[128, 128]
  v_psum_t: psum[128, 128]
  v_sbuf_t: sbuf[128, 128]
  scores_t_psum: psum[128, 128]
  scores_t: sbuf[128, 128]
  attn_out: psum[128, 128]
  attn_out_sbuf: sbuf[128, 128]
  q_sbuf = mov(q)
  k_sbuf = mov(k)
  v_sbuf = mov(v)
  qk_psum = matmul(q_sbuf, k_sbuf)
  qk = mov(qk_psum)
  row_max = reduce maximum(qk)
  norm_row = subtract(qk, row_max)
  exp_row = exp(norm_row)
  sum_row = reduce add(exp_row)
  inverse_sum_row = reciprocal(sum_row)
  scores = multiply(exp_row, inverse_sum_row)
  v_psum_t = transpose(v_sbuf)
  v_sbuf_t = mov(v_psum_t)
  scores_t_psum = transpose(scores)
  scores_t = mov(scores_t_psum)
  attn_out = matmul(scores_t, v_sbuf_t)
  attn_out_sbuf = mov(attn_out)
  kernel_out = mov(attn_out_sbuf)
