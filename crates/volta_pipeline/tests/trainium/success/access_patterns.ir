kernel kernel(a, prod) -> out
  a: hbm[2, 6]
  prod: hbm[2, 3, 2]
  out: hbm[2, 6]
  t: sbuf[2, 3, 2]
  sums: sbuf[2, 3]
  acc: psum[2, 3, 2]
  staged: sbuf[2, 3, 2]
  t = dma(a.ap([[6, 2], [1, 3], [3, 2]], offset=0))
  sums = reduce add(t)
  out[0:2, 0:3] = dma(sums)
  out[0:2, 3:6] = dma(t.ap([[6, 2], [2, 3]], offset=1))
  acc = matmul(t[0:2, 0, 0:2], t)
  staged = mov(acc)
  prod = dma(staged)
