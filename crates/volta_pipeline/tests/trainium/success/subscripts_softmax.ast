kernel kernel(x: [2, 3])
  kernel_out: shared_hbm[2, 3] of x.dtype
  data: sbuf[2, 3] of x.dtype
  dma_copy(dst=data, src=x)
  stats: sbuf[2, 2] of float32
  tensor_reduce(axis=(1,), data=data, dst=stats[:, 0], op=nki.language.maximum)
  norm: sbuf[2, 3] of float32
  tensor_scalar(data=data, dst=norm, op0=nki.language.subtract, operand0=stats[:, 0])
  norm_row: shared_hbm[1, 2, 3] of float32
  dma_copy(dst=norm_row[0], src=norm)
  norm_buf: sbuf[2, 3] of norm_row.dtype
  dma_copy(dst=norm_buf, src=norm_row[0])
  exp_vals: sbuf[2, 1, 3] of float32
  activation(data=norm_buf, dst=exp_vals[:, 0, :], op=nki.language.exp)
  tensor_reduce(axis=(1,), data=exp_vals[:, 0, :], dst=stats[:, 1], op=nki.language.add)
  reciprocal(data=stats[:, 1], dst=stats[:, 1])
  result: sbuf[2, 3] of float32
  tensor_scalar(data=exp_vals[:, 0, :], dst=result, op0=nki.language.multiply, operand0=stats[:, 1])
  dma_copy(dst=kernel_out, src=result)
  return kernel_out
