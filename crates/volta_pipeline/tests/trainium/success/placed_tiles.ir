kernel kernel(a_t, b) -> out
  a_t: hbm[4, 2]
  b: hbm[4, 3]
  out: hbm[3, 2]
  x: sbuf[4, 2] at (0, 0), 4 bytes each
  y: sbuf[4, 3] at (0, 32), 4 bytes each
  product: sbuf[2, 3] at (0, 64), 4 bytes each
  product_t: sbuf[3, 2] at (0, 96), 4 bytes each
  result: sbuf[3, 2] at (0, 128), 4 bytes each
  acc: psum[2, 3] at (0, 0), 4 bytes each
  staged: psum[3, 2] at (0, 0), 4 bytes each
  x = dma(a_t)
  y = dma(b)
  acc = matmul(x[0:2, 0:2], y[0:2, 0:3], accumulate=False)  # in for#0[0] > for#1[0]
  acc = matmul(x[2:4, 0:2], y[2:4, 0:3], accumulate=True)  # in for#0[0] > for#1[1]
  acc = matmul(x[0:2, 0:2], y[0:2, 0:3], accumulate=False)  # in for#0[1] > for#2[0]
  acc = matmul(x[2:4, 0:2], y[2:4, 0:3], accumulate=True)  # in for#0[1] > for#2[1]
  product = mov(acc)
  product_t = dma_transpose(product)
  staged = mov(product_t)
  result = mov(staged)
  out = dma(result)
