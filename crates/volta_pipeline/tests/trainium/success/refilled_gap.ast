kernel kernel(a_t: [4, 2], b: [4, 2], out: [2, 4])
  x: sbuf[4, 2] of float32
  y: sbuf[4, 2] of float32
  acc: psum[2, 4] of float32
  z: sbuf[2, 4] of float32
  zeros: sbuf[2, 2] of float32
  dma_copy(dst=x, src=a_t)
  dma_copy(dst=y, src=b)
  nc_matmul(dst=acc[:, 0:2], moving=y, stationary=x)
  tensor_copy(dst=z, src=acc)
  memset(dst=zeros, value=0)
  dma_copy(dst=out[:, 0:2], src=z[:, 0:2])
  dma_copy(dst=out[:, 2:4], src=zeros)
