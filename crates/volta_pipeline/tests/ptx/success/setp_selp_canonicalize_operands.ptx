.version 8.6
.target sm_100a
.address_size 64

.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<3>;
    .reg .b64 %rd<3>;

    ld.param.u64 %rd1, [k_param_0];
    ld.param.u64 %rd2, [k_param_1];
    ld.global.u32 %r1, [%rd1];
    setp.eq.s32 %p1, %r1, -1;
    selp.b32 %r2, -1, 0, %p1;
    st.global.u32 [%rd2], %r2;
    ret;
}
