.version 8.6
.target sm_100a
.address_size 64

// Triton's split of a 4-byte fp16 load: a logical shift by 16 takes the high
// half, a 16-bit store the low half.
.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .b32 %r<3>;
    .reg .b64 %rd<3>;

    ld.param.u64 %rd1, [k_param_0];
    ld.param.u64 %rd2, [k_param_1];
    ld.global.b32 %r1, [%rd1];
    shr.u32 %r2, %r1, 16;
    st.global.b16 [%rd2], %r2;
    st.global.b16 [%rd2+2], %r1;
    ret;
}
