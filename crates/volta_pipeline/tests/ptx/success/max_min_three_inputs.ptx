.version 8.7
.target sm_100a
.address_size 64

// sm_100's three-input `max.f32 d, a, b, c`, its destination also its first source.
.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .f32 %f<4>;
    .reg .b64 %rd<3>;

    ld.param.u64 %rd1, [k_param_0];
    ld.param.u64 %rd2, [k_param_1];
    ld.global.f32 %f1, [%rd1];
    ld.global.f32 %f2, [%rd1+4];
    ld.global.f32 %f3, [%rd1+8];
    max.f32 %f1, %f1, %f2, %f3;
    min.f32 %f2, %f3, %f2, %f2;
    st.global.f32 [%rd2], %f1;
    st.global.f32 [%rd2+4], %f2;
    ret;
}
