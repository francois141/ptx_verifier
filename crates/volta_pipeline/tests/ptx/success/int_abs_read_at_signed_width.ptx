.version 8.6
.target sm_100a
.address_size 64

.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<3>;

    ld.param.u64 %rd1, [k_param_1];
    mov.u32 %r1, 0xFFFFFFFB;
    abs.s32 %r2, %r1;
    mov.u32 %r4, 0x80000000;
    abs.s32 %r5, %r4;
    st.global.u32 [%rd1], %r2;
    st.global.u32 [%rd1+4], %r5;
    ret;
}
