.version 8.6
.target sm_100a
.address_size 64

.visible .entry k(
    .param .u64 k_param_0
)
{
    .reg .f32 %f<3>;
    .reg .b32 %r<2>;
    .reg .b64 %rd<2>;

    ld.param.u64 %rd1, [k_param_0];

    mov.f32 %f1, 0f3FC00000; // 1.5
    mov.f32 %f2, 0f40200000; // 2.5
    cvt.rn.f16x2.f32 %r1, %f1, %f2;
    st.global.b32 [%rd1], %r1;

    ret;
}
