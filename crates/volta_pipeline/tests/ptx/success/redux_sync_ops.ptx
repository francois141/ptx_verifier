// redux.sync over a full warp (vLLM's 128+-expert top-k, softmax row maxima): lane l holds l
// (integer ops) and in[l] (f32). out[0..5] = add 496, min 0, max 31, and 0, or 31, xor 0;
// out[6], out[7] = max and max.abs of the 32 inputs (symbolic), out[8] = add.s32 of 1 - l
// over the low half-warp mask (-104).
.version 8.6
.target sm_100a
.address_size 64

.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<16>;
    .reg .b64 %rd<5>;

    ld.param.u64 %rd1, [k_param_0];
    ld.param.u64 %rd2, [k_param_1];
    mov.u32 %r1, %tid.x;
    redux.sync.add.u32 %r2, %r1, -1;
    redux.sync.min.u32 %r3, %r1, -1;
    redux.sync.max.s32 %r4, %r1, -1;
    redux.sync.and.b32 %r5, %r1, -1;
    redux.sync.or.b32 %r6, %r1, -1;
    redux.sync.xor.b32 %r7, %r1, -1;
    mul.wide.u32 %rd3, %r1, 4;
    add.s64 %rd4, %rd1, %rd3;
    ld.global.f32 %r8, [%rd4];
    redux.sync.max.f32 %r9, %r8, -1;
    redux.sync.max.abs.f32 %r10, %r8, -1;
    setp.lt.u32 %p1, %r1, 16;
    sub.s32 %r11, 1, %r1;
    mov.u32 %r12, 0;
    @%p1 redux.sync.add.s32 %r12, %r11, 65535;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra DONE;
    st.global.v4.u32 [%rd2], {%r2, %r3, %r4, %r5};
    st.global.v2.u32 [%rd2+16], {%r6, %r7};
    st.global.v2.f32 [%rd2+24], {%r9, %r10};
    st.global.u32 [%rd2+32], %r12;
DONE:
    ret;
}
