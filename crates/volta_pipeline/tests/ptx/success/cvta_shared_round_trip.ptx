.version 8.6
.target sm_100a
.address_size 64

// ThunderKittens' shared allocator: round a generic shared address up to a
// 1024-byte boundary, then convert it back. out[0] = in[0] (stored and
// reloaded there), out[1] = 1024 (the shared offset reached), out[2] = 0
// (the generic base's own alignment).
.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .b32 %r<7>;
    .reg .b64 %rd<10>;
    .shared .align 1024 .b8 sdata[2048];

    ld.param.u64 %rd1, [k_param_0];
    ld.param.u64 %rd2, [k_param_1];
    mov.u32 %r1, sdata;
    cvt.u64.u32 %rd3, %r1;
    cvta.shared.u64 %rd4, %rd3;
    add.s64 %rd5, %rd4, 1027;
    and.b64 %rd5, %rd5, -1024;
    and.b64 %rd6, %rd4, 1023;
    cvta.to.shared.u64 %rd7, %rd5;
    cvt.u32.u64 %r2, %rd7;
    ld.global.u32 %r3, [%rd1];
    st.shared.u32 [%r2], %r3;
    ld.shared.u32 %r4, [%r2];
    st.global.u32 [%rd2], %r4;
    sub.s64 %rd8, %rd7, %rd3;
    cvt.u32.u64 %r5, %rd8;
    st.global.u32 [%rd2+4], %r5;
    cvt.u32.u64 %r6, %rd6;
    st.global.u32 [%rd2+8], %r6;
    ret;
}
