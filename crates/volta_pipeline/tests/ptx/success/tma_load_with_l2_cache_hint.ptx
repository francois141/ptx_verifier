.version 8.6
.target sm_100a
.address_size 64

// `tma_1d_load_zero_fills_past_the_tensor_end` with the load's L2 cache hint, as
// TileLang emits it: the cache policy only sets an eviction priority, so
// out[0..7] = in[32..39], out[8..15] = 0 as before.
.visible .entry k(
    .param .align 64 .b8 maps[256]
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<4>;
    .reg .b64 %rd<6>;
    .shared .align 8 .b64 mbar;
    .shared .align 128 .b8 tile[64];

    mov.b64 %rd1, maps;
    add.s64 %rd2, %rd1, 128;
    cvta.param.u64 %rd3, %rd1;
    cvta.param.u64 %rd4, %rd2;
    mov.u32 %r1, mbar;
    mov.u32 %r2, tile;
    mbarrier.init.shared::cta.b64 [%r1], 1;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r1], 64;
    mov.b32 %r3, 32;
    mov.b64 %rd5, 1152921504606846976;
    cp.async.bulk.tensor.1d.shared::cta.global.mbarrier::complete_tx::bytes.L2::cache_hint [%r2], [%rd3, {%r3}], [%r1], %rd5;
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p1, [%r1], 0;
    @!%p1 bra WAIT;
    cp.async.bulk.tensor.1d.global.shared::cta.bulk_group [%rd4, {0}], [%r2];
    cp.async.bulk.commit_group;
    cp.async.bulk.wait_group.read 0;
    ret;
}
