.version 8.6
.target sm_100a
.address_size 64

// Every thread waits on the mbarrier, a CTA barrier orders every wait before thread 0's
// mbarrier.inval, and thread 0 then reuses the object's bytes: race free.
.visible .entry k(
    .param .u64 k_param_0
)
{
    .reg .pred %p<3>;
    .reg .b32 %r<4>;
    .reg .b64 %rd<3>;
    .shared .align 8 .b64 mb;

    mov.u32 %r1, %tid.x;
    setp.eq.u32 %p1, %r1, 0;
    mov.u32 %r2, mb;
    @%p1 mbarrier.init.shared::cta.b64 [%r2], 64;
    bar.sync 0;
    mbarrier.arrive.shared::cta.b64 %rd1, [%r2];
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p2, [%r2], 0;
    @!%p2 bra WAIT;
    bar.sync 0;
    // Thread 0 ends the object and reuses its bytes.
    @%p1 mbarrier.inval.shared::cta.b64 [%r2];
    mov.u64 %rd2, 7;
    @%p1 st.shared.u64 [%r2], %rd2;
    ld.param.u64 %rd2, [k_param_0];
    mov.u32 %r3, 1;
    @%p1 st.global.u32 [%rd2], %r3;
    ret;
}
