.version 8.6
.target sm_100a
.address_size 64

.visible .entry k()
{
    .reg .pred %zp<2>;
    .reg .b32 %zr<3>;
    .reg .pred %p<2>;
    .reg .b32 %r<6>;
    .reg .b64 %rd<5>;
    .shared .align 1024 .b8 a_buf[4096];
    .shared .align 1024 .b8 b_buf[1024];
    .shared .align 4 .b32 taddr_slot;
    .shared .align 8 .b64 mma_bar;
    .reg .pred %pw;
    .reg .b32 %rbar;

    // Thread 0 zeroes the operand tiles so the MMA reads no never-written byte.
    mov.u32 %zr0, %tid.x;
    setp.eq.u32 %zp0, %zr0, 0;
    @!%zp0 bra ZEROED;
    mov.u32 %zr0, 0;
    mov.u32 %zr1, a_buf;
    add.u32 %zr2, %zr1, 4096;
ZERO_A_BUF:
    st.shared.v4.b32 [%zr1], {%zr0, %zr0, %zr0, %zr0};
    add.u32 %zr1, %zr1, 16;
    setp.lt.u32 %zp1, %zr1, %zr2;
    @%zp1 bra ZERO_A_BUF;
    mov.u32 %zr1, b_buf;
    add.u32 %zr2, %zr1, 1024;
ZERO_B_BUF:
    st.shared.v4.b32 [%zr1], {%zr0, %zr0, %zr0, %zr0};
    add.u32 %zr1, %zr1, 16;
    setp.lt.u32 %zp1, %zr1, %zr2;
    @%zp1 bra ZERO_B_BUF;
ZEROED:
    fence.proxy.async.shared::cta;

    mov.u32 %r3, taddr_slot;
    tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 [%r3], 32;
    // tcgen05.alloc orders nothing: publish its address write to every lane.
    bar.warp.sync 0xffffffff;
    ld.shared.u32 %r1, [%r3];

    mov.u32 %r5, %tid.x;
    setp.eq.s32 %p1, %r5, 0;

    // SwizzleMode::None, stride_dim_byte_offset = 32 bytes (K=16 f16
    // elements, tightly packed - no atom concept for this mode).
    mov.u64 %rd1, a_buf;
    shr.u64 %rd1, %rd1, 4;
    or.b64 %rd1, %rd1, 70377334112256;
    mov.u64 %rd2, b_buf;
    shr.u64 %rd2, %rd2, 4;
    or.b64 %rd2, %rd2, 70377334112256;
    // dense, D=f32, A/B=f16, no negate/transpose, M=128, N=8.
    mov.u32 %r2, 134348816;
    mov.pred %p0, 0;
    mov.u32 %rbar, mma_bar;
    @%p1 mbarrier.init.shared.b64 [%rbar], 1;
    bar.sync 0;
    @%p1 tcgen05.mma.cta_group::1.kind::f16 [%r1+0], %rd1, %rd2, %r2, {0,0,0,0}, %p0;
    @%p1 tcgen05.commit.cta_group::1.mbarrier::arrive::one.b64 [%rbar];
MMA_WAIT:
    mbarrier.try_wait.parity.shared.b64 %pw, [%rbar], 0;
    @!%pw bra MMA_WAIT;
    // Free the columns once every Tensor Memory use is observed complete.
    tcgen05.dealloc.cta_group::1.sync.aligned.b32 %r1, 32;
    ret;
}
