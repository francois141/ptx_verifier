.version 8.6
.target sm_100a
.address_size 64

// `tcgen05_alloc_lanes_ordered_by_bar_warp_sync_is_accepted` with nCols in a
// register, as TileLang's tcgen05 GEMM passes it.

.visible .entry k(
    .param .u64 k_param_0
)
{
    .reg .pred %p<4>;
    .reg .b32 %r<10>;
    .reg .b64 %rd<3>;
    .reg .f32 %f<2>;
    .shared .align 4 .b32 taddr_slot;
    .shared .align 4 .b32 x;

    mov.u32 %r9, %tid.x;
    setp.eq.s32 %p1, %r9, 1;
    setp.eq.s32 %p2, %r9, 2;
    mov.u32 %r4, x;
    @%p1 st.shared.u32 [%r4], %r9;
    mov.u32 %r3, taddr_slot;
    mov.b32 %r5, 32;
    tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 [%r3], %r5;
    // tcgen05.alloc orders nothing: this orders lane 1's store and the alloc's address write
    // before every lane's loads.
    bar.warp.sync 0xffffffff;
    @%p2 ld.shared.u32 %r8, [%r4];
    ld.shared.u32 %r1, [%r3];
    tcgen05.dealloc.cta_group::1.sync.aligned.b32 %r1, %r5;
    @!%p2 bra DONE;
    cvt.rn.f32.u32 %f1, %r8;
    ld.param.u64 %rd1, [k_param_0];
    st.global.f32 [%rd1], %f1;
DONE:
    ret;
}
