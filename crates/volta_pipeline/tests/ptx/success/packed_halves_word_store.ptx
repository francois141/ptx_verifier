// Two 16-bit halves packed into one 32-bit store (vLLM's finalizeMoeRouting and TensorRT-LLM's
// MLA merge in bf16): cvt.u32.u16 zero-extends each half, shl 16 moves one up, or merges them.
// The word stored to a 2-byte output is its two elements: out[0], out[1] = in[0], in[1].
.version 8.6
.target sm_100a
.address_size 64

.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .b16 %rs<3>;
    .reg .b32 %r<5>;
    .reg .b64 %rd<3>;

    ld.param.u64 %rd1, [k_param_0];
    ld.param.u64 %rd2, [k_param_1];
    ld.global.b16 %rs1, [%rd1];
    ld.global.b16 %rs2, [%rd1+2];
    cvt.u32.u16 %r1, %rs1;
    cvt.u32.u16 %r2, %rs2;
    shl.b32 %r3, %r2, 16;
    or.b32 %r4, %r1, %r3;
    st.global.b32 [%rd2], %r4;
    ret;
}
