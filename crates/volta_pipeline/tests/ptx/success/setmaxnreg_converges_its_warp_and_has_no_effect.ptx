.version 8.6
.target sm_100a
.address_size 64

// `setmaxnreg` is a full-warp rendezvous whose effect on the register count is not modeled:
// under `.maxnreg 128`, warp 0 raises its count to 232 though no warp releases registers,
// and warp 1 lowers its own to 24. Each warp converges at its own instruction and runs on;
// every thread then stores its id: out[i] = i.
.visible .entry k(
    .param .u64 out
)
.maxnreg 128
{
    .reg .pred %p<2>;
    .reg .b32 %r<2>;
    .reg .b64 %rd<4>;

    ld.param.u64 %rd1, [out];
    mov.u32 %r1, %tid.x;
    setp.lt.u32 %p1, %r1, 32;
    @%p1 bra WARP0;
    setmaxnreg.dec.sync.aligned.u32 24;
    bra.uni STORE;
WARP0:
    setmaxnreg.inc.sync.aligned.u32 232;
STORE:
    mul.wide.u32 %rd2, %r1, 4;
    add.s64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r1;
    ret;
}
