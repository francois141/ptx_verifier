.version 8.6
.target sm_100a
.address_size 64

// A by-value struct `maps` holds two host-encoded 5-D tensor maps of the same
// 4x2x2x2x2 f32 shape (`in` at byte 0, `out` at byte 128), reached through
// `cvta.param`. One thread TMA-loads the 4x1x2x1x2 box at {0, 1, 0, 1, 0},
// which steps through every dimension's stride, and TMA-stores it to `out` at
// the same coordinates: out[i] = in[i] for i in 20-23, 28-31, 52-55, 60-63.
.visible .entry k(
    .param .align 64 .b8 maps[256]
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<4>;
    .reg .b64 %rd<5>;
    .shared .align 8 .b64 mbar;
    .shared .align 128 .b8 tile[64];

    mov.b64 %rd1, maps;
    add.s64 %rd2, %rd1, 128;
    cvta.param.u64 %rd3, %rd1;
    cvta.param.u64 %rd4, %rd2;
    mov.u32 %r1, mbar;
    mov.u32 %r2, tile;
    mbarrier.init.shared::cta.b64 [%r1], 1;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r1], 64;
    mov.b32 %r3, 1;
    cp.async.bulk.tensor.5d.shared::cta.global.mbarrier::complete_tx::bytes [%r2], [%rd3, {0, %r3, 0, %r3, 0}], [%r1];
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p1, [%r1], 0;
    @!%p1 bra WAIT;
    cp.async.bulk.tensor.5d.global.shared::cta.bulk_group [%rd4, {0, %r3, 0, %r3, 0}], [%r2];
    cp.async.bulk.commit_group;
    cp.async.bulk.wait_group.read 0;
    ret;
}
