.version 8.6
.target sm_100a
.address_size 64

.visible .entry k(
    .param .u64 k_param_0
)
{
    .reg .f32 %f0;
    .reg .b64 %rd0;

    tcgen05.fence::before_thread_sync;
    tcgen05.fence::after_thread_sync;

    ld.param.u64 %rd0, [k_param_0];
    mov.f32 %f0, 0f3F800000;
    st.global.f32 [%rd0], %f0;
    ret;
}
