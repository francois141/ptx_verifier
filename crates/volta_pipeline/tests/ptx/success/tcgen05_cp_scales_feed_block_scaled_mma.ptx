.version 8.6
.target sm_100a
.address_size 64

// The block-scaled MMA of `tcgen05_mma_kind_mxf8f6f4_symbolic_scales`, its UE8M0 scales
// reaching Tensor Memory through shared memory and `tcgen05.cp.32x128b.warpx4` (DeepGEMM's
// path): thread t stores scale word t at row t % 32, word t / 32 of a 32 x 16-byte matrix
// (8-row core matrices, SBO = 128), which the copy places at lane l, column c = word l + 32c
// in every partition. The MMA follows the copies with no commit (the pipelined pair).
.visible .entry k(
    .param .u64 sa,
    .param .u64 sb,
    .param .u64 out
)
{
    .reg .pred %zp<2>;
    .reg .b32 %zr<3>;
    .reg .pred %p<3>;
    .reg .b32 %r<20>;
    .reg .b64 %rd<12>;
    .reg .f32 %f<2>;
    .shared .align 1024 .b8 a_buf[4096];
    .shared .align 1024 .b8 b_buf[256];
    .shared .align 128 .b8 sa_buf[512];
    .shared .align 128 .b8 sb_buf[512];
    .shared .align 4 .b32 taddr_slot;
    .shared .align 8 .b64 mma_bar;
    .reg .pred %pw;
    .reg .b32 %rbar;

    // Thread 0 zeroes the operand tiles so the MMA reads no never-written byte.
    mov.u32 %zr0, %tid.x;
    setp.eq.u32 %zp0, %zr0, 0;
    @!%zp0 bra ZEROED;
    mov.u32 %zr0, 0;
    mov.u32 %zr1, a_buf;
    add.u32 %zr2, %zr1, 4096;
ZERO_A_BUF:
    st.shared.v4.b32 [%zr1], {%zr0, %zr0, %zr0, %zr0};
    add.u32 %zr1, %zr1, 16;
    setp.lt.u32 %zp1, %zr1, %zr2;
    @%zp1 bra ZERO_A_BUF;
    mov.u32 %zr1, b_buf;
    add.u32 %zr2, %zr1, 256;
ZERO_B_BUF:
    st.shared.v4.b32 [%zr1], {%zr0, %zr0, %zr0, %zr0};
    add.u32 %zr1, %zr1, 16;
    setp.lt.u32 %zp1, %zr1, %zr2;
    @%zp1 bra ZERO_B_BUF;
ZEROED:

    mov.u32 %r10, %tid.x;
    setp.eq.u32 %p1, %r10, 0;
    setp.lt.u32 %p2, %r10, 32;
    mov.u32 %r3, taddr_slot;
    mov.u32 %rbar, mma_bar;
    @!%p2 bra ALLOCATED;
    tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 [%r3], 32;
ALLOCATED:
    @%p1 mbarrier.init.shared.b64 [%rbar], 1;

    // A[0][0] = e4m3 1.0, B[0][0] = e5m2 1.0.
    mov.u64 %rd1, a_buf;
    mov.u64 %rd2, b_buf;
    @%p1 st.shared.b8 [%rd1], 0x38;
    @%p1 st.shared.b8 [%rd2], 0x3c;
    fence.proxy.async.shared::cta;
    bar.sync 0;
    ld.shared.u32 %r1, [%r3];

    // Thread t loads scale word t of each and stores it at row t % 32, word t / 32.
    ld.param.u64 %rd5, [sa];
    ld.param.u64 %rd6, [sb];
    mul.wide.u32 %rd7, %r10, 4;
    add.s64 %rd8, %rd5, %rd7;
    add.s64 %rd9, %rd6, %rd7;
    ld.global.u32 %r12, [%rd8];
    ld.global.u32 %r16, [%rd9];
    and.b32 %r11, %r10, 31;
    shl.b32 %r11, %r11, 4;
    shr.u32 %r13, %r10, 5;
    shl.b32 %r13, %r13, 2;
    add.u32 %r11, %r11, %r13;
    mov.u32 %r14, sa_buf;
    add.u32 %r14, %r14, %r11;
    st.shared.u32 [%r14], %r12;
    mov.u32 %r15, sb_buf;
    add.u32 %r15, %r15, %r11;
    st.shared.u32 [%r15], %r16;
    fence.proxy.async.shared::cta;
    bar.sync 0;
    shr.u32 %r4, %r10, 5;
    shl.b32 %r4, %r4, 21;
    add.u32 %r5, %r1, %r4;

    // SwizzleMode::None, SBO = 128, descriptor version 1: A's scales to columns 8-11, B's
    // to 16-19.
    mov.u64 %rd11, sa_buf;
    shr.u64 %rd11, %rd11, 4;
    or.b64 %rd11, %rd11, 70403103916032;
    @%p1 tcgen05.cp.cta_group::1.32x128b.warpx4 [%r1+8], %rd11;
    mov.u64 %rd11, sb_buf;
    shr.u64 %rd11, %rd11, 4;
    or.b64 %rd11, %rd11, 70403103916032;
    @%p1 tcgen05.cp.cta_group::1.warpx4.32x128b [%r1+16], %rd11;

    // SwizzleMode::None, LBO = 128, SBO = 256, descriptor version 1.
    shr.u64 %rd3, %rd1, 4;
    or.b64 %rd3, %rd3, 70437464178688;
    shr.u64 %rd4, %rd2, 4;
    or.b64 %rd4, %rd4, 70437464178688;
    // dense, A = e4m3, B = e5m2, M = 128, N = 8, UE8M0, SFA_ID = 1, SFB_ID = 2.
    mov.u32 %r2, 679609376;
    mov.pred %p0, 0;
    @%p1 tcgen05.mma.cta_group::1.kind::mxf8f6f4.block_scale.block32 [%r1+0], %rd3, %rd4, %r2, [%r1+8], [%r1+16], %p0;
    @%p1 tcgen05.commit.cta_group::1.mbarrier::arrive::one.b64 [%rbar];
MMA_WAIT:
    mbarrier.try_wait.parity.shared.b64 %pw, [%rbar], 0;
    @!%pw bra MMA_WAIT;
    tcgen05.fence::after_thread_sync;

    tcgen05.ld.sync.aligned.32x32b.x1.b32 %f1, [%r5];
    tcgen05.wait::ld.sync.aligned;
    ld.param.u64 %rd10, [out];
    @%p1 st.global.f32 [%rd10], %f1;
    // Warp 0 frees the columns once every warp's wait::ld is behind the barrier.
    tcgen05.fence::before_thread_sync;
    bar.sync 0;
    @%p2 tcgen05.dealloc.cta_group::1.sync.aligned.b32 %r1, 32;
    ret;
}
