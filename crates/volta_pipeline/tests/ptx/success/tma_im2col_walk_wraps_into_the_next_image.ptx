.version 8.6
.target sm_100a
.address_size 64

// Example 5 of Triton's Gluon im2col tutorial, tested there on a GPU, with 4
// channels: `in` is 2 images of 4x4 pixels behind an im2col map whose bounding
// box spans H, W in [-1, 2]. A 16-pixel column from the filter base n = 0,
// h = 1, w = 2 walks W fastest, wraps at the box edge and runs into image 1;
// the pixels outside the tensor (h or w = -1) are zero-filled. The column is
// stored to `out` as 16 rows of 4 channels.
.visible .entry k(
    .param .align 64 .b8 maps[256]
)
{
    .reg .pred %p<2>;
    .reg .b16 %rs<2>;
    .reg .b32 %r<5>;
    .reg .b64 %rd<5>;
    .shared .align 8 .b64 mbar;
    .shared .align 128 .b8 tile[256];

    mov.b64 %rd1, maps;
    add.s64 %rd2, %rd1, 128;
    cvta.param.u64 %rd3, %rd1;
    cvta.param.u64 %rd4, %rd2;
    mov.u32 %r1, mbar;
    mov.u32 %r2, tile;
    mbarrier.init.shared::cta.b64 [%r1], 1;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r1], 256;
    mov.b32 %r3, 1;
    mov.b32 %r4, 2;
    mov.b16 %rs1, 0;
    cp.async.bulk.tensor.4d.shared::cta.global.im2col.mbarrier::complete_tx::bytes [%r2], [%rd3, {0, %r4, %r3, 0}], [%r1], {%rs1, %rs1};
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p1, [%r1], 0;
    @!%p1 bra WAIT;
    cp.async.bulk.tensor.2d.global.shared::cta.bulk_group [%rd4, {0, 0}], [%r2];
    cp.async.bulk.commit_group;
    cp.async.bulk.wait_group.read 0;
    ret;
}
