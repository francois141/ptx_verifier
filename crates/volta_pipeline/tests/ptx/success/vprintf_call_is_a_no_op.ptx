.version 8.6
.target sm_100a
.address_size 64

// Device printf (CUTLASS's FMHA prints on one guarded path) touches no modeled memory: the
// call does nothing and its retval slot holds 0. out[0] = in[0], out[1] = the retval.
.extern .func  (.param .b32 func_retval0) vprintf
(
    .param .b64 vprintf_param_0,
    .param .b64 vprintf_param_1
)
;
.global .align 1 .b8 $str[3] = {104, 105, 0};

.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .b32 %r<4>;
    .reg .b64 %rd<6>;

    ld.param.u64 %rd1, [k_param_0];
    ld.param.u64 %rd2, [k_param_1];
    ld.global.u32 %r1, [%rd1];
    mov.u64 %rd3, $str;
    cvta.global.u64 %rd4, %rd3;
    { // callseq 0, 0
    .param .b64 param0;
    st.param.b64 [param0], %rd4;
    .param .b64 param1;
    st.param.b64 [param1], 0;
    .param .b32 retval0;
    call.uni (retval0), vprintf, (param0, param1);
    ld.param.b32 %r2, [retval0];
    } // callseq 0
    st.global.u32 [%rd2], %r1;
    st.global.u32 [%rd2+4], %r2;
    ret;
}
