.version 8.6
.target sm_100a
.address_size 64

.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .b16 %rs<3>;
    .reg .b32 %r<2>;
    .reg .b64 %rd<3>;

    ld.param.u64 %rd1, [k_param_0];
    ld.param.u64 %rd2, [k_param_1];
    ld.global.u16 %rs1, [%rd1];
    ld.global.u16 %rs2, [%rd1+2];
    mov.b32 %r1, {%rs1, %rs2};
    st.global.b32 [%rd2], %r1;
    ret;
}
