.version 8.6
.target sm_100a
.address_size 64

// A by-value struct `args` holds a host-encoded tensor map (an 8x8 f32 `in` at
// byte 0, reached through `cvta.param`) and the `out` pointer at byte 128. One
// thread TMA-loads rows 2-5 of `in`, waits on the mbarrier, and copies the tile
// to `out`: out[0..31] = in[16..47].
.visible .entry k(
    .param .align 64 .b8 args[136]
)
{
    .reg .pred %p<3>;
    .reg .b32 %r<8>;
    .reg .f32 %f<2>;
    .reg .b64 %rd<6>;
    .shared .align 8 .b64 mbar;
    .shared .align 128 .b8 tile[128];

    mov.b64 %rd1, args;
    cvta.param.u64 %rd2, %rd1;
    ld.param.u64 %rd3, [args+128];
    mov.u32 %r1, mbar;
    mov.u32 %r2, tile;
    mbarrier.init.shared::cta.b64 [%r1], 1;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r1], 128;
    mov.b32 %r3, 2;
    cp.async.bulk.tensor.2d.shared::cluster.global.tile.mbarrier::complete_tx::bytes [%r2], [%rd2, {0, %r3}], [%r1];
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p1, [%r1], 0;
    @!%p1 bra WAIT;
    mov.u32 %r4, 0;
COPY:
    shl.b32 %r5, %r4, 2;
    add.u32 %r6, %r2, %r5;
    ld.shared.f32 %f1, [%r6];
    mul.wide.u32 %rd4, %r4, 4;
    add.s64 %rd5, %rd3, %rd4;
    st.global.f32 [%rd5], %f1;
    add.u32 %r4, %r4, 1;
    setp.lt.u32 %p2, %r4, 32;
    @%p2 bra COPY;
    ret;
}
