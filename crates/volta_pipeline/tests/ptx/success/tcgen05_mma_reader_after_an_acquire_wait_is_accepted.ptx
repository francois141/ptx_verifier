.version 8.6
.target sm_100a
.address_size 64

.visible .entry k()
{
    .reg .pred %zp<2>;
    .reg .b32 %zr<3>;
    .reg .pred %p<4>;
    .reg .pred %pw;
    .reg .b32 %r<8>;
    .reg .b64 %rd<3>;
    .shared .align 1024 .b8 a_buf[4096];
    .shared .align 1024 .b8 b_buf[1024];
    .shared .align 4 .b32 taddr_slot;
    .shared .align 8 .b64 mma_bar;
    .shared .align 8 .b64 gate;

    // Thread 0 zeroes the operand tiles so the MMA reads no never-written byte.
    mov.u32 %zr0, %tid.x;
    setp.eq.u32 %zp0, %zr0, 0;
    @!%zp0 bra ZEROED;
    mov.u32 %zr0, 0;
    mov.u32 %zr1, a_buf;
    add.u32 %zr2, %zr1, 4096;
ZERO_A_BUF:
    st.shared.v4.b32 [%zr1], {%zr0, %zr0, %zr0, %zr0};
    add.u32 %zr1, %zr1, 16;
    setp.lt.u32 %zp1, %zr1, %zr2;
    @%zp1 bra ZERO_A_BUF;
    mov.u32 %zr1, b_buf;
    add.u32 %zr2, %zr1, 1024;
ZERO_B_BUF:
    st.shared.v4.b32 [%zr1], {%zr0, %zr0, %zr0, %zr0};
    add.u32 %zr1, %zr1, 16;
    setp.lt.u32 %zp1, %zr1, %zr2;
    @%zp1 bra ZERO_B_BUF;
ZEROED:
    fence.proxy.async.shared::cta;

    mov.u32 %r3, taddr_slot;
    mov.u32 %r4, mma_bar;
    mov.u32 %r6, gate;
    mov.u32 %r5, %tid.x;
    setp.eq.s32 %p1, %r5, 0;
    setp.lt.u32 %p2, %r5, 32;
    @!%p2 bra ALLOCATED;
    tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 [%r3], 32;
ALLOCATED:
    @%p1 mbarrier.init.shared.b64 [%r4], 1;
    @%p1 mbarrier.init.shared.b64 [%r6], 32;
    bar.sync 0;
    ld.shared.u32 %r1, [%r3];

    mov.u64 %rd1, a_buf;
    shr.u64 %rd1, %rd1, 4;
    or.b64 %rd1, %rd1, 70377334112256;
    mov.u64 %rd2, b_buf;
    shr.u64 %rd2, %rd2, 4;
    or.b64 %rd2, %rd2, 70377334112256;
    mov.u32 %r2, 134348816;
    mov.pred %p0, 0;
    @%p1 tcgen05.mma.cta_group::1.kind::f16 [%r1+0], %rd1, %rd2, %r2, {0,0,0,0}, %p0;
    @%p1 tcgen05.commit.cta_group::1.mbarrier::arrive::one.b64 [%r4];

    bar.sync 0;
    // The default `.acquire` wait pairs with the commit's release arrival, so warp 1
    // reads D with no `tcgen05.fence::after_thread_sync`.
WAIT:
    mbarrier.try_wait.parity.shared.b64 %pw, [%r4], 0;
    @!%pw bra WAIT;
    @%p2 bra DONE;
    add.u32 %r6, %r1, 2097152;
    tcgen05.ld.sync.aligned.32x32b.x1.b32 %r7, [%r6];
    tcgen05.wait::ld.sync.aligned;
DONE:
    // Warp 0 allocated; it frees the columns once warp 1's wait::ld is behind the barrier.
    bar.sync 0;
    @%p2 tcgen05.dealloc.cta_group::1.sync.aligned.b32 %r1, 32;
    ret;
}
