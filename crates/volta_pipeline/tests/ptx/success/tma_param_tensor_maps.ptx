.version 8.6
.target sm_100a
.address_size 64

// A by-value struct `maps` holds two host-encoded tensor maps (an 8x8 f32 `in`
// at byte 0, an 8x8 f32 `out` at byte 128), reached through `cvta.param`. One
// thread TMA-loads rows 2-5 of `in`, waits in ThunderKittens' exit-label loop,
// TMA-stores the tile to rows 0-3 of `out` and waits for its reads:
// out[0..31] = in[16..47].
.visible .entry k(
    .param .align 64 .b8 maps[256]
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<4>;
    .reg .b64 %rd<5>;
    .shared .align 8 .b64 mbar;
    .shared .align 128 .b8 tile[128];

    mov.b64 %rd1, maps;
    add.s64 %rd2, %rd1, 128;
    cvta.param.u64 %rd3, %rd1;
    cvta.param.u64 %rd4, %rd2;
    mov.u32 %r1, mbar;
    mov.u32 %r2, tile;
    mbarrier.init.shared::cta.b64 [%r1], 1;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r1], 128;
    mov.b32 %r3, 2;
    cp.async.bulk.tensor.2d.shared::cluster.global.tile.mbarrier::complete_tx::bytes [%r2], [%rd3, {0, %r3}], [%r1];
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p1, [%r1], 0;
    @%p1 bra.uni DONE;
    bra.uni WAIT;
DONE:
    cp.async.bulk.tensor.2d.global.shared::cta.tile.bulk_group [%rd4, {0, 0}], [%r2];
    cp.async.bulk.commit_group;
    cp.async.bulk.wait_group.read 0;
    ret;
}
