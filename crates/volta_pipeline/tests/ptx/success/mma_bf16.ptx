.version 8.6
.target sm_100a
.address_size 64

// mma.sync m16n8k16 over bf16 A (16x16) and B (16x8) fragments loaded from
// global memory; lane 0 stores its four f32 accumulator elements.
.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1,
    .param .u64 k_param_2
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<8>;
    .reg .f32 %f<5>;
    .reg .b64 %rd<9>;

    ld.param.u64 %rd1, [k_param_0];
    ld.param.u64 %rd2, [k_param_1];
    ld.param.u64 %rd3, [k_param_2];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd4, %r1, 16;
    add.s64 %rd5, %rd1, %rd4;
    ld.global.v4.b32 {%r2, %r3, %r4, %r5}, [%rd5];
    mul.wide.u32 %rd6, %r1, 8;
    add.s64 %rd7, %rd2, %rd6;
    ld.global.v2.b32 {%r6, %r7}, [%rd7];
    mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%f1, %f2, %f3, %f4}, {%r2, %r3, %r4, %r5}, {%r6, %r7}, {0f00000000, 0f00000000, 0f00000000, 0f00000000};
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra DONE;
    st.global.v4.f32 [%rd3], {%f1, %f2, %f3, %f4};
DONE:
    ret;
}
