.version 8.6
.target sm_100a
.address_size 64

// A 128B-swizzled TMA box landing 512 bytes past a 1024-byte boundary has swizzle base
// offset (512 / 128) % 8 = 4 (PTX ISA 5.5.7): row r's 16-byte chunk c lands at chunk
// c ^ ((4 + r) % 8). The thread copies the 1024 bytes out in shared order: out[0] = in[16].
.visible .entry k(
    .param .align 64 .b8 args[136]
)
{
    .reg .pred %p<3>;
    .reg .b32 %r<8>;
    .reg .f32 %f<2>;
    .reg .b64 %rd<6>;
    .shared .align 8 .b64 mbar;
    .shared .align 1024 .b8 buf[2048];

    mov.b64 %rd1, args;
    cvta.param.u64 %rd2, %rd1;
    ld.param.u64 %rd3, [args+128];
    mov.u32 %r1, mbar;
    mov.u32 %r2, buf;
    add.u32 %r2, %r2, 512;
    mbarrier.init.shared::cta.b64 [%r1], 1;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r1], 1024;
    cp.async.bulk.tensor.2d.shared::cluster.global.tile.mbarrier::complete_tx::bytes [%r2], [%rd2, {0, 0}], [%r1];
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p1, [%r1], 0;
    @!%p1 bra WAIT;
    mov.u32 %r4, 0;
COPY:
    shl.b32 %r5, %r4, 2;
    add.u32 %r6, %r2, %r5;
    ld.shared.f32 %f1, [%r6];
    mul.wide.u32 %rd4, %r4, 4;
    add.s64 %rd5, %rd3, %rd4;
    st.global.f32 [%rd5], %f1;
    add.u32 %r4, %r4, 1;
    setp.lt.u32 %p2, %r4, 256;
    @%p2 bra COPY;
    ret;
}
