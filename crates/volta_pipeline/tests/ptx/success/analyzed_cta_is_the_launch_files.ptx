.version 8.7
.target sm_100a
.address_size 64

// The analyzed block's coordinates: `%ctaid` and, every cluster holding one CTA,
// `%clusterid` read the launch's `cta`.
.visible .entry k(
    .param .u64 k_param_0
)
{
    .reg .b32 %r<4>;
    .reg .b64 %rd<2>;

    ld.param.u64 %rd1, [k_param_0];
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ctaid.y;
    mov.u32 %r3, %clusterid.x;
    st.global.u32 [%rd1], %r1;
    st.global.u32 [%rd1+4], %r2;
    st.global.u32 [%rd1+8], %r3;
    ret;
}
