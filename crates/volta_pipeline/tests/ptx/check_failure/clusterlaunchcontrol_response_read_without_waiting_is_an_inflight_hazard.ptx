// Thread 0 requests a cancel; warp 1 reads the response after a bar.sync but
// without waiting on the mbarrier, so the async write is still in flight.
.version 8.7
.target sm_100a
.address_size 64

.visible .entry k()
{
    .reg .pred %p<2>;
    .reg .b32 %r<4>;
    .reg .b128 %q0;
    .shared .align 16 .b8 clc_response[16];
    .shared .align 8 .b64 clc_mbar;

    mov.u32 %r0, %tid.x;
    mov.u32 %r1, clc_mbar;
    mov.u32 %r2, clc_response;
    setp.eq.u32 %p0, %r0, 0;
    @%p0 mbarrier.init.shared::cta.b64 [%r1], 1;
    @%p0 mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r1], 16;
    @%p0 clusterlaunchcontrol.try_cancel.async.shared::cta.mbarrier::complete_tx::bytes.b128 [%r2], [%r1];
    bar.sync 0;
    setp.eq.u32 %p1, %r0, 32;
    @%p1 ld.shared.b128 %q0, [%r2];
    ret;
}
