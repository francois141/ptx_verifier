.version 8.6
.target sm_100a
.address_size 64

.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .pred %p<2>;
    .reg .f32 %f<4>;
    .reg .b32 %r<6>;
    .reg .b64 %rd<4>;
    .shared .align 4 .b8 sdata[4];

    ld.param.u64 %rd1, [k_param_0];
    ld.param.u64 %rd2, [k_param_1];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r1, %tid.x;
    ld.global.f32 %f1, [%rd1];
    cvt.rn.f32.u32 %f2, %r1;
    mov.u32 %r3, sdata;
    st.shared.f32 [%r3], %f2;
    bar.sync 0;
    ld.shared.f32 %f3, [%r3];
    setp.eq.u32 %p1, %r1, 0;
    @%p1 st.global.f32 [%rd2], %f3;
    ret;
}
