.version 8.6
.target sm_100a
.address_size 64

.visible .entry k()
{
    .reg .pred %p0;
    .reg .b32 %r<3>;
    .reg .b64 %rd<3>;

    mov.u32 %r1, 0;
    mov.u64 %rd1, 0;
    mov.u64 %rd2, 0;
    // dtype=F32, atype=2 (no .kind::f16 type: 0 is f16, 1 bf16), M=128, N=256
    // (bit-packed by hand).
    mov.u32 %r2, 138412304;
    mov.pred %p0, 0;
    tcgen05.mma.cta_group::1.kind::f16 [%r1+0], %rd1, %rd2, %r2, {0,0,0,0}, %p0;
    ret;
}
