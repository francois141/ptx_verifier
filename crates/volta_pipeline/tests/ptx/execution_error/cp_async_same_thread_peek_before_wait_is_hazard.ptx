.version 8.6
.target sm_100a
.address_size 64

.visible .entry k(
    .param .u64 in,
    .param .u64 out
)
{
    .reg .b32 %r<4>;
    .reg .b64 %rd<4>;
    .shared .align 4 .b8 sdata[4];

    ld.param.u64 %rd1, [in];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, sdata;
    cp.async.ca.shared.global [%r1], [%rd1], 4;
    cp.async.commit_group;
    ld.shared.u32 %r2, [%r1];
    ld.param.u64 %rd2, [out];
    cvta.to.global.u64 %rd2, %rd2;
    st.global.u32 [%rd2], %r2;
    ret;
}
