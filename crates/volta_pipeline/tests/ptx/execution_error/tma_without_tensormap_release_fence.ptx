.version 8.6
.target sm_100a
.address_size 64

.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .pred %p0;
    .reg .b16 %rs<3>;
    .reg .b32 %r<3>;
    .reg .b64 %rd<3>;
    .reg .b32 %tid;
    .reg .pred %pz;

    .global .align 128 .b8 gbl[128];
    .shared .align 8 .b8 full[8];
    .shared .align 16 .b8 sa[32];

    ld.param.u64 %rd1, [k_param_0];
    mov.u32 %tid, %tid.x;
    setp.ne.u32 %pz, %tid, 0;
    @%pz bra END;

    tensormap.replace.tile.global_address.global.b1024.b64 [gbl], %rd1;
    tensormap.replace.tile.rank.global.b1024.b32 [gbl], 1;
    tensormap.replace.tile.global_dim.global.b1024.b32 [gbl], 0, 8;
    tensormap.replace.tile.global_dim.global.b1024.b32 [gbl], 1, 8;
    tensormap.replace.tile.global_stride.global.b1024.b64 [gbl], 0, 16;
    tensormap.replace.tile.box_dim.global.b1024.b32 [gbl], 0, 4;
    tensormap.replace.tile.box_dim.global.b1024.b32 [gbl], 1, 4;
    tensormap.replace.tile.element_stride.global.b1024.b32 [gbl], 0, 1;
    tensormap.replace.tile.element_stride.global.b1024.b32 [gbl], 1, 1;
    tensormap.replace.tile.elemtype.global.b1024.b32 [gbl], 6;
    tensormap.replace.tile.interleave_layout.global.b1024.b32 [gbl], 0;
    tensormap.replace.tile.swizzle_mode.global.b1024.b32 [gbl], 0;
    tensormap.replace.tile.swizzle_atomicity.global.b1024.b32 [gbl], 0;
    tensormap.replace.tile.fill_mode.global.b1024.b32 [gbl], 0;
    // No release: the acquire orders nothing of the replaces before the copy.
    fence.proxy.tensormap::generic.acquire.gpu [gbl], 128;
    mbarrier.init.shared::cta.b64 [full], 1;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [full], 32;

    mov.u32 %r1, 6;
    mov.u32 %r2, 6;
    cp.async.bulk.tensor.2d.shared::cluster.global.tile.mbarrier::complete_tx::bytes [sa], [gbl, {%r1, %r2}], [full];

WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p0, [full], 0;
    @!%p0 bra WAIT;

    ld.shared.u16 %rs1, [sa];
    ld.shared.u16 %rs2, [sa+30];

    ld.param.u64 %rd2, [k_param_1];
    st.global.u16 [%rd2], %rs1;
    st.global.u16 [%rd2+2], %rs2;
END:
    ret;
}
