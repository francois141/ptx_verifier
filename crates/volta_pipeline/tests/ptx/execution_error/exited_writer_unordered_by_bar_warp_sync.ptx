.version 8.6
.target sm_100a
.address_size 64

.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<5>;
    .reg .b64 %rd<2>;
    .shared .align 4 .b8 sdata[8];

    ld.param.u64 %rd1, [k_param_1];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, sdata;
    setp.eq.u32 %p1, %r1, 1;
    mov.u32 %r3, 42;
@%p1 st.shared.u32 [%r2], %r3;
@%p1 ret;
    bar.warp.sync 3;
    ld.shared.u32 %r4, [%r2];
    st.global.u32 [%rd1], %r4;
    ret;
}
