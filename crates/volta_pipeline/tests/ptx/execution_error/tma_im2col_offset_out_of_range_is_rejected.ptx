.version 8.6
.target sm_100a
.address_size 64

// An im2col load of a 4-D tensor with the H offset 256: the PTX ISA bounds a
// 4-D tensor's im2col offsets to [0, 255].
.visible .entry k(
    .param .align 64 .b8 maps[256]
)
{
    .reg .pred %p<2>;
    .reg .b16 %rs<3>;
    .reg .b32 %r<3>;
    .reg .b64 %rd<3>;
    .shared .align 8 .b64 mbar;
    .shared .align 128 .b8 tile[256];

    mov.b64 %rd1, maps;
    cvta.param.u64 %rd2, %rd1;
    mov.u32 %r1, mbar;
    mov.u32 %r2, tile;
    mbarrier.init.shared::cta.b64 [%r1], 1;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r1], 256;
    mov.b16 %rs1, 0;
    mov.b16 %rs2, 256;
    cp.async.bulk.tensor.4d.shared::cta.global.im2col.mbarrier::complete_tx::bytes [%r2], [%rd2, {0, 0, 0, 0}], [%r1], {%rs1, %rs2};
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p1, [%r1], 0;
    @!%p1 bra WAIT;
    ret;
}
