.version 8.6
.target sm_100a
.address_size 64

.visible .entry k(
    .param .u64 in,
    .param .u64 out
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<5>;
    .reg .b64 %rd<3>;
    .shared .align 4 .b8 sdata[4];

    mov.u32 %r1, %tid.x;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra $DONE;
    ld.param.u64 %rd1, [in];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r2, sdata;
    cp.async.ca.shared.global [%r2], [%rd1], 4;
    cp.async.commit_group;
    mov.u32 %r3, 7;
    st.shared.u32 [%r2], %r3;
    cp.async.wait_all;
    ld.shared.u32 %r4, [%r2];
    ld.param.u64 %rd2, [out];
    cvta.to.global.u64 %rd2, %rd2;
    st.global.u32 [%rd2], %r4;
$DONE:
    ret;
}
