// clusterlaunchcontrol_declined_response_read_as_two_halves_ends_the_loop without
// the @%p2 guard: like Gluon, get_first_ctaid runs before branching on is_canceled,
// so it decodes the declined response, which is undefined behavior.
.version 8.7
.target sm_100a
.address_size 64

.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .pred %p<4>;
    .reg .b32 %r<12>;
    .reg .b64 %rd<8>;
    .reg .f32 %f<2>;
    .reg .b128 %q0;
    .shared .align 16 .b8 clc_response[16];
    .shared .align 8 .b64 clc_mbar;

    ld.param.u64 %rd0, [k_param_0];
    ld.param.u64 %rd1, [k_param_1];
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %ntid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, clc_mbar;
    mov.u32 %r4, clc_response;
    mov.u32 %r5, 0;
    setp.eq.u32 %p0, %r0, 0;
    @%p0 mbarrier.init.shared::cta.b64 [%r3], 1;
    bar.sync 0;

TILE:
    mad.lo.u32 %r6, %r2, %r1, %r0;
    mul.wide.u32 %rd2, %r6, 4;
    add.u64 %rd3, %rd0, %rd2;
    add.u64 %rd4, %rd1, %rd2;
    ld.global.f32 %f0, [%rd3];
    add.f32 %f1, %f0, %f0;
    st.global.f32 [%rd4], %f1;

    @%p0 mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r3], 16;
    @%p0 clusterlaunchcontrol.try_cancel.async.shared::cta.mbarrier::complete_tx::bytes.b128 [%r4], [%r3];
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p1, [%r3], %r5;
    @!%p1 bra WAIT;

    ld.shared.v2.b64 {%rd5, %rd6}, [%r4];
    mov.b128 %q0, {%rd5, %rd6};
    clusterlaunchcontrol.query_cancel.is_canceled.pred.b128 %p2, %q0;
    clusterlaunchcontrol.query_cancel.get_first_ctaid::x.b32.b128 %r2, %q0;
    xor.b32 %r5, %r5, 1;
    // Every reader is done with the response before the next try_cancel.
    bar.sync 0;
    @%p2 bra TILE;
    ret;
}
