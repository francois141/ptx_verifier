.version 8.6
.target sm_100a
.address_size 64

.visible .entry k()
{
    .reg .pred %p<2>;
    .reg .b32 %r<3>;
    .shared .align 8 .b64 mbar;

    mov.u32 %r2, mbar;
    mbarrier.init.shared::cta.b64 [%r2], 1;
    mbarrier.arrive.shared::cta.b64 _, [%r2];
    mbarrier.arrive.relaxed.cta.shared::cta.b64 _, [%r2];
    ret;
}
