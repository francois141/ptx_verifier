.version 8.6
.target sm_100a
.address_size 64
.visible .entry k(.param .u64 k_param_0)
{
    .reg .pred %p<6>;
    .reg .b32 %r<10>;
    .reg .b64 %rd<3>;
    .shared .align 4 .b32 data;
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, data;
    setp.eq.u32 %p1, %r0, 0;
    setp.eq.u32 %p2, %r0, 20;
    @%p1 st.shared.u32 [%r1], 42;
    // lanes 0-15 take the bar.sync at iteration 0, lanes 16-31 at iteration 1
    shr.u32 %r6, %r0, 4;
    mov.u32 %r7, 0;
LOOP:
    setp.eq.u32 %p3, %r7, %r6;
    @%p3 bar.sync 0;
    add.u32 %r7, %r7, 1;
    setp.lt.u32 %p4, %r7, 2;
    @%p4 bra LOOP;
    @%p2 ld.shared.u32 %r4, [%r1];
    ld.param.u64 %rd1, [k_param_0];
    @%p2 st.global.u32 [%rd1], %r4;
    ret;
}
