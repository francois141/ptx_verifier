// A product of two plain ex2.approx (FlashInfer's online merge, state.cuh:58-60) is no CUDA
// accurate expf: its exponents carry no H + L split, so it must keep lowering's own ex2 form,
// exp(x / f32(log2 e))^2, not become exp(2 x / (H + L)) (1e-8 off in the exponent).
.version 8.6
.target sm_100a
.address_size 64

.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .b32 %r<4>;
    .reg .b64 %rd<3>;

    ld.param.u64 %rd1, [k_param_0];
    ld.param.u64 %rd2, [k_param_1];
    ld.global.f32 %r1, [%rd1];
    ex2.approx.ftz.f32 %r2, %r1;
    mul.f32 %r3, %r2, %r2;
    st.global.f32 [%rd2], %r3;
    ret;
}
