.version 8.6
.target sm_100a
.address_size 64

.visible .entry k()
{
    .reg .b32 %r<12>;
    .shared .align 32 .b8 sdata[2048];

    mov.u32 %r1, sdata;
    add.s32 %r1, %r1, 0;
    mov.u32 %r2, 20;
    wmma.load.a.sync.aligned.row.m16n16k16.shared.f16 {%r3, %r4, %r5, %r6, %r7, %r8, %r9, %r10}, [%r1], %r2;
    ret;
}
