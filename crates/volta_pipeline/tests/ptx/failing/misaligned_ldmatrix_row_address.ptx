.version 8.6
.target sm_100a
.address_size 64

.visible .entry k()
{
    .reg .b32 %r<10>;
    .shared .align 16 .b8 sdata[1024];

    mov.u32 %r1, %tid.x;
    shl.b32 %r2, %r1, 4;
    mov.u32 %r3, sdata;
    add.s32 %r4, %r3, %r2;
    add.s32 %r4, %r4, 8;
    ldmatrix.sync.aligned.x4.m8n8.shared.b16 {%r5, %r6, %r7, %r8}, [%r4];
    ret;
}
