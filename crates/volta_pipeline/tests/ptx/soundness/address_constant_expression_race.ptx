.version 8.0
.target sm_80
.address_size 64

.visible .entry k(.param .u64 output)
{
    .reg .b64 %ptr;
    .reg .b32 %tid;
    .reg .pred %p0, %p1;

    ld.param.u64 %ptr, [output];
    mov.u32 %tid, %tid.x;
    setp.eq.u32 %p0, %tid, 0;
    setp.eq.u32 %p1, %tid, 1;
    @%p0 st.global.u32 [%ptr + (4 | 4)], 1;
    @%p1 st.global.u32 [%ptr + 4], 2;
    ret;
}
