.version 8.6
.target sm_100a
.address_size 64

.visible .entry k()
{
    .reg .pred %p;
    .reg .b32 %r;
    .shared .align 8 .b64 mb;

    mov.u32 %r, mb;
    mbarrier.init.shared::cta.b64 [%r], 1;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r], 16;
    mbarrier.complete_tx.shared::cta.b64 [%r], 16;
WAIT:
    mbarrier.try_wait.parity.acquire.sys.shared::cta.b64 %p, [%r], 0;
    @!%p bra WAIT;
    ret;
}
