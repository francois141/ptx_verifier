.version 8.6
.target sm_100a
.address_size 64

.visible .entry k()
{
    .reg .pred %zp<2>;
    .reg .b32 %zr<3>;
    .reg .b32 %r<12>;
    .shared .align 32 .b8 sdata[2048];

    // Thread 0 zeroes the tile so the wmma.load reads no never-written byte.
    mov.u32 %zr0, %tid.x;
    setp.eq.u32 %zp0, %zr0, 0;
    @!%zp0 bra ZEROED;
    mov.u32 %zr0, 0;
    mov.u32 %zr1, sdata;
    add.u32 %zr2, %zr1, 2048;
ZERO_SDATA:
    st.shared.v4.b32 [%zr1], {%zr0, %zr0, %zr0, %zr0};
    add.u32 %zr1, %zr1, 16;
    setp.lt.u32 %zp1, %zr1, %zr2;
    @%zp1 bra ZERO_SDATA;
ZEROED:
    bar.sync 0;

    mov.u32 %r1, sdata;
    add.s32 %r1, %r1, 0;
    mov.u32 %r2, 32;
    wmma.load.a.sync.aligned.row.m16n16k16.shared.f16 {%r3, %r4, %r5, %r6, %r7, %r8, %r9, %r10}, [%r1], %r2;
    ret;
}
