.version 8.6
.target sm_100a
.address_size 64

.visible .entry k()
{
    .reg .pred %p<4>;
    .reg .b32 %r<8>;
    .shared .align 4 .b32 taddr_slot;

    mov.u32 %r3, taddr_slot;
    mov.u32 %r5, %tid.x;
    setp.lt.u32 %p2, %r5, 32;
    @!%p2 bra RELINQUISH;
    tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 [%r3], 32;
    bar.sync 1, 64;
    ld.shared.u32 %r1, [%r3];
    tcgen05.dealloc.cta_group::1.sync.aligned.b32 %r1, 32;
    bra DONE;
RELINQUISH:
    // Ordered after warp 0's alloc: no schedule relinquishes first.
    bar.sync 1, 64;
    tcgen05.relinquish_alloc_permit.cta_group::1.sync.aligned;
DONE:
    ret;
}
