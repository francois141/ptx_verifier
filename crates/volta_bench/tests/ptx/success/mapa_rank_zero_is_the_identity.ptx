// Clusters are assumed to hold a single CTA, so mapa into rank 0 maps each
// thread's shared slot to its own address: out[i] = &buf[i] - &buf[0] = 4*i.
.version 8.7
.target sm_100a
.address_size 64

.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<4>;
    .shared .align 4 .b8 buf[16];

    ld.param.u64 %rd0, [k_param_1];
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, buf;
    shl.b32 %r2, %r0, 2;
    add.u32 %r3, %r1, %r2;
    mov.u32 %r4, 0;
    mapa.shared::cluster.u32 %r5, %r3, %r4;
    sub.u32 %r6, %r5, %r1;
    mul.wide.u32 %rd1, %r0, 4;
    add.u64 %rd2, %rd0, %rd1;
    st.global.u32 [%rd2], %r6;
    ret;
}
