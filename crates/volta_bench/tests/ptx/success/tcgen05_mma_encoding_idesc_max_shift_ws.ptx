.version 8.6
.target sm_100a
.address_size 64

.visible .entry k()
{
    .reg .pred %zp<2>;
    .reg .b32 %zr<3>;
    .reg .pred %p<2>;
    .reg .b32 %r<5>;
    .reg .b64 %rd<3>;
    // At shared address 0, where the descriptors' operands start.
    .shared .align 1024 .b8 operands[32768];
    .shared .align 4 .b32 taddr_slot;
    .shared .align 8 .b64 mma_bar;
    .reg .pred %pw;
    .reg .b32 %rbar;

    // Thread 0 zeroes the operand tiles so the MMA reads no never-written byte.
    mov.u32 %zr0, %tid.x;
    setp.eq.u32 %zp0, %zr0, 0;
    @!%zp0 bra ZEROED;
    mov.u32 %zr0, 0;
    mov.u32 %zr1, operands;
    add.u32 %zr2, %zr1, 32768;
ZERO_OPERANDS:
    st.shared.v4.b32 [%zr1], {%zr0, %zr0, %zr0, %zr0};
    add.u32 %zr1, %zr1, 16;
    setp.lt.u32 %zp1, %zr1, %zr2;
    @%zp1 bra ZERO_OPERANDS;
ZEROED:
    fence.proxy.async.shared::cta;

    mov.u32 %r3, taddr_slot;
    tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 [%r3], 512;
    bar.sync 0;
    ld.shared.u32 %r1, [%r3];
    mov.u32 %r4, %tid.x;
    setp.eq.u32 %p1, %r4, 0;
    mov.u64 %rd1, 4611756662049472512;
    mov.u64 %rd2, 4611756662049472512;
    mov.u32 %r2, 1209073680;
    mov.pred %p0, 0;
    mov.u32 %rbar, mma_bar;
    @%p1 mbarrier.init.shared.b64 [%rbar], 1;
    bar.sync 0;
    @%p1 tcgen05.mma.ws.cta_group::1.kind::f16 [%r1+0], %rd1, %rd2, %r2, %p0;
    @%p1 tcgen05.commit.cta_group::1.mbarrier::arrive::one.b64 [%rbar];
MMA_WAIT:
    mbarrier.try_wait.parity.shared.b64 %pw, [%rbar], 0;
    @!%pw bra MMA_WAIT;
    // Free the columns once every Tensor Memory use is observed complete.
    tcgen05.dealloc.cta_group::1.sync.aligned.b32 %r1, 512;
    ret;
}
