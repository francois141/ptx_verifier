.version 8.6
.target sm_100a
.address_size 64

.visible .entry k(
    .param .u64 k_param_0
)
{
    .reg .b32 %r<10>;
    .reg .b64 %rd<3>;
    .reg .f32 %f<2>;
    .shared .align 4 .b32 taddr_slot;

    mov.u32 %r9, %tid.x;
    mov.u32 %r3, taddr_slot;
    tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 [%r3], 32;
    ld.shared.u32 %r1, [%r3];

    tcgen05.st.sync.aligned.32x32b.x1.b32 [%r1], %r9;
    tcgen05.fence::before_thread_sync;
    tcgen05.fence::after_thread_sync;
    tcgen05.ld.sync.aligned.32x32b.x1.b32 %r8, [%r1];
    tcgen05.wait::ld.sync.aligned;
