.version 8.6
.target sm_100a
.address_size 64

// Each side of a divergent branch elects the lowest lane of activemask as its
// leader and stores. On hardware each side sees only its own lanes active, so
// lane 0 and lane 16 both store to s[0]. Volta's activemask is "every non-exited
// lane", so it elects lane 0 on both sides and sees a single store.
.visible .entry k()
{
    .reg .pred %p<4>;
    .reg .b32 %r<12>;
    .shared .align 4 .b32 s[1];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, s;
    and.b32 %r3, %r1, 31;
    shl.b32 %r4, 1, %r3;
    setp.lt.u32 %p1, %r3, 16;
    @%p1 bra A;
    activemask.b32 %r6;
    neg.s32 %r7, %r6;
    and.b32 %r8, %r6, %r7;
    setp.eq.u32 %p2, %r8, %r4;
    @%p2 st.shared.u32 [%r2], 2;
    bra.uni J;
A:
    activemask.b32 %r6;
    neg.s32 %r7, %r6;
    and.b32 %r8, %r6, %r7;
    setp.eq.u32 %p2, %r8, %r4;
    @%p2 st.shared.u32 [%r2], 1;
J:
    bar.sync 0;
    ret;
}
