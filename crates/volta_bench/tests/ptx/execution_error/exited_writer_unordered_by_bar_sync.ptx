.version 8.6
.target sm_100a
.address_size 64

.visible .entry k(
    .param .u64 k_in,
    .param .u64 k_out
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<6>;
    .reg .b64 %rd<8>;
    .shared .align 4 .b32 buf[32];

    ld.param.u64 %rd1, [k_in];
    ld.param.u64 %rd2, [k_out];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r1, %tid.x;
    and.b32 %r2, %r1, 31;
    shl.b32 %r3, %r2, 2;
    cvt.u64.u32 %rd3, %r3;
    mov.u32 %r4, buf;
    add.u32 %r4, %r4, %r3;
    setp.lt.u32 %p1, %r1, 32;
@%p1 bra READER;

    add.s64 %rd4, %rd1, %rd3;
    ld.global.u32 %r5, [%rd4];
    st.shared.u32 [%r4], %r5;
    exit;

READER:
    bar.sync 0;
    ld.shared.u32 %r5, [%r4];
    add.s64 %rd5, %rd2, %rd3;
    st.global.u32 [%rd5], %r5;
    ret;
}
