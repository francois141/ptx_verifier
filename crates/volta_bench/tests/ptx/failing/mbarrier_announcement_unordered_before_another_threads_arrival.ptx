.version 8.0
.target sm_90a
.address_size 64

// Thread 0 announces each 16-byte bulk copy into `buf` with a bare expect_tx
// and issues it; thread 1 alone arrives on the count-1 barrier `full`. Nothing
// orders thread 0's announcements before thread 1's arrival: had thread 1
// arrived first, phase 0 would have completed with no bytes pending and every
// waiter would read `buf` before the copies land. On this schedule the copies
// are announced and landed first, so the trace itself is clean.
.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .pred %p<3>;
    .reg .pred %pw;
    .reg .b32 %r<4>;
    .reg .b64 %rd<6>;
    .shared .align 16 .b8 buf[32];
    .shared .align 8 .b64 full;

    ld.param.u64 %rd1, [k_param_0];
    ld.param.u64 %rd2, [k_param_1];
    add.s64 %rd3, %rd1, 16;
    mov.u32 %r1, full;
    mov.u32 %r2, %tid.x;
    setp.eq.s32 %p1, %r2, 0;
    setp.eq.s32 %p2, %r2, 1;
    @%p1 mbarrier.init.shared::cta.b64 [%r1], 1;
    bar.sync 0;
    @!%p1 bra ARRIVE;
    mbarrier.expect_tx.shared::cta.b64 [%r1], 16;
    cp.async.bulk.shared::cta.global.mbarrier::complete_tx::bytes [buf], [%rd1], 16, [%r1];
    mbarrier.expect_tx.shared::cta.b64 [%r1], 16;
    cp.async.bulk.shared::cta.global.mbarrier::complete_tx::bytes [buf+16], [%rd3], 16, [%r1];
    bra WAIT;
ARRIVE:
    @%p2 mbarrier.arrive.shared::cta.b64 _, [%r1];
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %pw, [%r1], 0;
    @!%pw bra WAIT;
    ld.shared.u32 %r3, [buf+16];
    mul.wide.u32 %rd4, %r2, 4;
    add.s64 %rd5, %rd2, %rd4;
    st.global.u32 [%rd5], %r3;
    ret;
}
