.version 8.6
.target sm_100a
.address_size 64

// Barrier 0 completes one phase with all 64 threads (through a register id), then warp 0
// alone reuses it with count 32. The ISA allows a new count in a new phase; Volta does not.
.visible .entry k()
{
    .reg .pred %p<2>;
    .reg .b32 %r<8>;
    mov.u32 %r1, %tid.x;
    mov.u32 %r6, 0;
    bar.sync %r6, 64;
    setp.ge.u32 %p1, %r1, 32;
    @%p1 bra DONE;
    bar.sync 0, 32;
DONE:
    ret;
}
