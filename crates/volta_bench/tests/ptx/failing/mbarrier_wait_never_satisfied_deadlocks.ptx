.version 8.0
.target sm_80
.address_size 64

.visible .entry k()
{
    .reg .pred %p<2>;
    .reg .b32 %r<3>;
    .shared .align 8 .b64 mbar;

    mov.u32 %r1, %tid.x;
    setp.eq.s32 %p0, %r1, 0;
    mov.u32 %r2, mbar;

    @%p0 mbarrier.init.shared::cta.b64 [%r2], 2;
    bar.sync 0;
    @%p0 mbarrier.arrive.shared::cta.b64 _, [%r2];
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p1, [%r2], 0;
    @!%p1 bra WAIT;
    ret;
}
