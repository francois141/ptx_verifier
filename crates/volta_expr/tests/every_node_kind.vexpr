volta-expr 1
n0 = elem "in \"quoted\" \\ name" 7
n1 = param "N"
n2 = int -5
n3 = real 1/3
n4 = real inf
n5 = real -inf
n6 = real 
n7 = bool true
n8 = sym 42
n9 = read "in \"quoted\" \\ name" n2
n10 = discarded
n11 = undefined
n12 = neg n0
n13 = exp n0
n14 = log n0
n15 = sqrt n0
n16 = rcp n0
n17 = abs n0
n18 = sign n0
n19 = erf n0
n20 = rint n0
n21 = trunc n0
n22 = bitnot n0
n23 = not n0
n24 = tofloat n0
n25 = add n0 n1
n26 = sub n0 n1
n27 = mul n0 n1
n28 = div n0 n1
n29 = rem n0 n1
n30 = max n0 n1
n31 = min n0 n1
n32 = bitand n0 n1
n33 = bitor n0 n1
n34 = bitxor n0 n1
n35 = shl n0 n1
n36 = shr n0 n1
n37 = lshr n0 n1
n38 = eq n0 n1
n39 = ne n0 n1
n40 = lt n0 n1
n41 = le n0 n1
n42 = gt n0 n1
n43 = ge n0 n1
n44 = and n0 n1
n45 = or n0 n1
n46 = select n0 n1 n2
n47 = fma n0 n1 n2
out "out" 0 n0
out "out" 1 n1
out "out" 2 n2
out "out" 3 n3
out "out" 4 n4
out "out" 5 n5
out "out" 6 n6
