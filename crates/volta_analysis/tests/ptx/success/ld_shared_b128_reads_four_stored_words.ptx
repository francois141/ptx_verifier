// A 16-byte .b128 load of four 4-byte words stored separately yields their
// 4x32 lanes, which mov.b128 unpacks back in order.
.version 8.7
.target sm_100a
.address_size 64

.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .b32 %r0;
    .reg .f32 %f<8>;
    .reg .b64 %rd<2>;
    .reg .b128 %q0;
    .shared .align 16 .b8 buf[16];

    ld.param.u64 %rd0, [k_param_0];
    ld.param.u64 %rd1, [k_param_1];
    mov.u32 %r0, buf;
    ld.global.v4.f32 {%f0, %f1, %f2, %f3}, [%rd0];
    st.shared.v4.f32 [%r0], {%f0, %f1, %f2, %f3};
    ld.shared.b128 %q0, [%r0];
    mov.b128 {%f4, %f5, %f6, %f7}, %q0;
    st.global.v4.f32 [%rd1], {%f4, %f5, %f6, %f7};
    ret;
}
