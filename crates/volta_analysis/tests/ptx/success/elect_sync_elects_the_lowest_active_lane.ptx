.version 8.0
.target sm_80
.address_size 64

.visible .entry k(
    .param .u64 k_param_0
)
{
    .reg .pred %p<2>;
    .reg .f32 %f<4>;
    .reg .b32 %r<3>;
    .reg .b64 %rd<3>;

    mov.u32 %r1, %tid.x;
    elect.sync %r2|%p0, -1;

    mov.f32 %f1, 0f00000000;
    @%p0 cvt.rn.f32.u32 %f2, %r2;
    @%p0 mov.f32 %f3, 0f447A0000;
    @%p0 add.f32 %f1, %f2, %f3;

    ld.param.u64 %rd1, [k_param_0];
    mul.wide.u32 %rd2, %r1, 4;
    add.s64 %rd2, %rd1, %rd2;
    st.global.f32 [%rd2], %f1;
    ret;
}
