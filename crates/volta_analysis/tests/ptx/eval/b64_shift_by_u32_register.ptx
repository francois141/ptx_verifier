.version 8.0
.target sm_80
.address_size 64

.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .b32 %r<3>;
    .reg .b64 %rd<6>;

    ld.param.u64 %rd2, [k_param_1];
    mov.u64 %rd3, 3;
    mov.u32 %r2, 40;
    shl.b64 %rd4, %rd3, %r2;
    shr.u64 %rd5, %rd4, %r2;
    st.global.u64 [%rd2], %rd4;
    st.global.u64 [%rd2+8], %rd5;
    ret;
}
