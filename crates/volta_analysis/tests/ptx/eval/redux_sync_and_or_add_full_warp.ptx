.version 8.0
.target sm_80
.address_size 64

.visible .entry k(
    .param .u64 k_param_0
)
{
    .reg .b32 %r<5>;
    .reg .b64 %rd<3>;

    ld.param.u64 %rd0, [k_param_0];
    mov.u32 %r0, %tid.x;
    redux.sync.and.b32 %r1, %r0, -1;
    redux.sync.or.b32 %r2, %r0, -1;
    redux.sync.add.u32 %r3, %r0, -1;
    mul.wide.u32 %rd1, %r0, 12;
    add.u64 %rd2, %rd0, %rd1;
    st.global.u32 [%rd2], %r1;
    add.u64 %rd2, %rd2, 4;
    st.global.u32 [%rd2], %r2;
    add.u64 %rd2, %rd2, 4;
    st.global.u32 [%rd2], %r3;
    ret;
}
