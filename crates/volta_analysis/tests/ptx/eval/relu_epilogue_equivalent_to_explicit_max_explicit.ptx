.version 8.0
.target sm_80
.address_size 64

.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .b16 %rs<2>;
    .reg .f32 %f<4>;
    .reg .b32 %r<4>;
    .reg .b64 %rd<7>;

    ld.param.u64 %rd1, [k_param_0];
    ld.param.u64 %rd2, [k_param_1];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r1, %tid.x;
    shl.b32 %r2, %r1, 2;
    cvt.u64.u32 %rd3, %r2;
    add.s64 %rd4, %rd1, %rd3;
    ld.global.f32 %f1, [%rd4];
    shl.b32 %r3, %r1, 1;
    cvt.u64.u32 %rd5, %r3;
    add.s64 %rd6, %rd2, %rd5;
    mov.f32 %f2, 0f00000000;
    max.f32 %f3, %f2, %f1;
    cvt.rn.f16.f32 %rs1, %f3;
    st.global.u16 [%rd6], %rs1;
    ret;
}
