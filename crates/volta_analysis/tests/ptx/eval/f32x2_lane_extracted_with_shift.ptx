.version 8.0
.target sm_80
.address_size 64

.visible .entry k(
    .param .u64 k_param_0,
    .param .u64 k_param_1
)
{
    .reg .f32 %f<5>;
    .reg .b32 %r<5>;
    .reg .b64 %rd<12>;

    ld.param.u64 %rd1, [k_param_0];
    ld.param.u64 %rd2, [k_param_1];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r1, %tid.x;
    shl.b32 %r2, %r1, 3;
    cvt.u64.u32 %rd3, %r2;
    add.s64 %rd4, %rd1, %rd3;
    add.s64 %rd5, %rd2, %rd3;
    ld.global.b64 %rd6, [%rd4];
    fma.rn.f32x2 %rd7, %rd6, %rd6, %rd6;
    shr.u64 %rd8, %rd7, 32;
    mov.b64 {%f3, _}, %rd7;
    mov.b64 {%f4, _}, %rd8;
    st.global.v2.f32 [%rd5], {%f3, %f4};
    ret;
}
