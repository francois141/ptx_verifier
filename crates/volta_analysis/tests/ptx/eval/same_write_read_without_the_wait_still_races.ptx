.version 8.0
.target sm_80
.address_size 64

.visible .entry k()
{
    .reg .pred %p<2>;
    .reg .b32 %r<7>;
    .shared .align 4 .b32 data;

    mov.u32 %r1, %tid.x;
    setp.eq.s32 %p0, %r1, 0;
    mov.u32 %r4, data;

    @%p0 mov.u32 %r5, 42;
    @%p0 st.shared.u32 [%r4], %r5;

    @!%p0 ld.shared.u32 %r6, [%r4];
    ret;
}
