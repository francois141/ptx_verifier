kernel kernel(x: [2, 3])
  kernel_out: shared_hbm[2, 3] of x.dtype
  data: sbuf[2, 3] of x.dtype
  dma_copy(dst=data, src=x)
  row_max: sbuf[2, 1] of float32
  tensor_reduce(axis=(1,), data=data, dst=row_max, op=nki.language.maximum)
  norm: sbuf[2, 3] of float32
  tensor_scalar(data=data, dst=norm, op0=nki.language.subtract, operand0=row_max)
  exp_vals: sbuf[2, 3] of float32
  activation(data=norm, dst=exp_vals, op=nki.language.exp)
  row_sum: sbuf[2, 1] of float32
  tensor_reduce(axis=(1,), data=exp_vals, dst=row_sum, op=nki.language.add)
  inv_sum: sbuf[2, 1] of float32
  reciprocal(data=row_sum, dst=inv_sum)
  result: sbuf[2, 3] of float32
  tensor_scalar(data=exp_vals, dst=result, op0=nki.language.multiply, operand0=inv_sum)
  dma_copy(dst=kernel_out, src=result)
  return kernel_out
