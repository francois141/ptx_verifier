kernel kernel(a_t: [4, 2], b: [4, 3])
  out: shared_hbm[3, 2] of float32
  x: sbuf[4, 2] of float32 at (0, 0)
  y: sbuf[4, 3] of float32 at (0, 32)
  product: sbuf[2, 3] of float32 at (0, 64)
  product_t: sbuf[3, 2] of float32 at (0, 96)
  result: sbuf[3, 2] of float32 at (0, 128)
  acc: psum[2, 3] of float32 at (0, 0)
  staged: psum[3, 2] of float32 at (0, 0)
  dma_copy(dst=x, src=a_t)
  dma_copy(dst=y, src=b)
  nc_matmul(accumulate=False, dst=acc, moving=y[0:2, :], stationary=x[0:2, :])
  nc_matmul(accumulate=True, dst=acc, moving=y[2:4, :], stationary=x[2:4, :])
  nc_matmul(accumulate=False, dst=acc, moving=y[0:2, :], stationary=x[0:2, :])
  nc_matmul(accumulate=True, dst=acc, moving=y[2:4, :], stationary=x[2:4, :])
  tensor_copy(dst=product, engine=nki.isa.vector_engine, src=acc)
  dma_transpose(axes=(1, 0), dst=product_t, src=product)
  tensor_copy(dst=staged, src=product_t)
  tensor_copy(dst=result, engine=nki.isa.scalar_engine, src=staged)
  dma_copy(dst=out, src=result)
  return out
