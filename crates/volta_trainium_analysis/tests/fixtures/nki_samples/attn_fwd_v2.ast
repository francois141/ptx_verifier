kernel attn_fwd_v2(q: [128, 128], k: [128, 128], v: [128, 128])
  kernel_out: shared_hbm[128, 128] of q.dtype
  q_sbuf: sbuf[128, 128] of q.dtype
  dma_copy(dst=q_sbuf, src=q)
  k_sbuf: sbuf[128, 128] of k.dtype
  dma_copy(dst=k_sbuf, src=k)
  v_sbuf: sbuf[128, 128] of v.dtype
  dma_copy(dst=v_sbuf, src=v)
  qk: psum[128, 128] of float32
  nc_matmul(dst=qk, moving=k_sbuf, stationary=q_sbuf)
  qk_sbuf: sbuf[128, 128] of float32
  tensor_copy(dst=qk_sbuf, src=qk)
  softmax_isa[0].row_max: sbuf[128, 1] of float32
  tensor_reduce(axis=(1,), data=qk_sbuf, dst=softmax_isa[0].row_max, op=nki.language.maximum)
  softmax_isa[0].norm: sbuf[128, 128] of float32
  tensor_scalar(data=qk_sbuf, dst=softmax_isa[0].norm, op0=nki.language.subtract, operand0=softmax_isa[0].row_max)
  softmax_isa[0].exp_vals: sbuf[128, 128] of float32
  activation(data=softmax_isa[0].norm, dst=softmax_isa[0].exp_vals, op=nki.language.exp)
  softmax_isa[0].row_sum: sbuf[128, 1] of float32
  tensor_reduce(axis=(1,), data=softmax_isa[0].exp_vals, dst=softmax_isa[0].row_sum, op=nki.language.add)
  softmax_isa[0].inv_sum: sbuf[128, 1] of float32
  reciprocal(data=softmax_isa[0].row_sum, dst=softmax_isa[0].inv_sum)
  softmax_isa[0].result: sbuf[128, 128] of float32
  tensor_scalar(data=softmax_isa[0].exp_vals, dst=softmax_isa[0].result, op0=nki.language.multiply, operand0=softmax_isa[0].inv_sum)
  scores_t_psum: psum[128, 128] of float32
  nc_transpose(data=softmax_isa[0].result, dst=scores_t_psum)
  scores_t: sbuf[128, 128] of float32
  tensor_copy(dst=scores_t, src=scores_t_psum)
  v_t_psum: psum[128, 128] of float32
  nc_transpose(data=v_sbuf, dst=v_t_psum)
  v_t: sbuf[128, 128] of v_sbuf.dtype
  tensor_copy(dst=v_t, src=v_t_psum)
  attn_out: psum[128, 128] of float32
  nc_matmul(dst=attn_out, moving=v_t, stationary=scores_t)
  attn_out_sbuf: sbuf[128, 128] of float32
  tensor_copy(dst=attn_out_sbuf, src=attn_out)
  dma_copy(dst=kernel_out, src=attn_out_sbuf)
  return kernel_out
